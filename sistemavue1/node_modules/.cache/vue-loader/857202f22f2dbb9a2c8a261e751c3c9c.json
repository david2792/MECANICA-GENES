/\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { mapState } from \"vuex\";\nexport default {\n  data() {\n    return {\n      search: \"\",\n      headers: [\n        { text: \"Opciones\", value: \"opciones\" },\n        { text: \"N° Timbrado\", value: \"NumeroTimbrado\" },\n        { text: \"Código Sucursal\", value: \"CodigoSucursal\" },\n        { text: \"Punto de Expedición\", value: \"PuntoExpedicion\" },\n        { text: \"Fecha inicio Vigencia\", value: \"FechaInicioVigencia\" },\n        { text: \"Fecha fin vigencia\", value: \"FechaFinVigencia\" },\n      ],\n      timbrado: this.createFreshTimbrado(),\n      menu: false,\n      menu2: false,\n      dialog: false,\n      token_configracion: [],\n      editedIndex: true,\n    };\n  },\n  name: \"ListadoTimbrado\",\n  mounted() {\n    let header = { \"auth-token\": this.$store.state.token };\n    let configuracion = { headers: header };\n    this.token_configracion = configuracion;\n    this.$store.dispatch(\"getTimbrados\", configuracion);\n    this.$store.dispatch(\"getSucursales\", configuracion);\n    this.$store.dispatch(\"getTipoDocumentos\", configuracion);\n  },\n  computed: {\n    ...mapState([\"timbrados\", \"sucursales\", \"tipoDocumento\"]),\n  },\n  methods: {\n    createFreshTimbrado() {\n      return {\n        NumeroTimbrado: \"\",\n        CodigoSucursal: \"\",\n        PuntoExpedicion: \"\",\n        CodigoTiposDocumento: \"\",\n        FechaInicioVigencia: new Date().toISOString().substr(0, 10),\n        FechaFinVigencia: new Date().toISOString().substr(0, 10),\n        NumeroInicial: \"\",\n        NumeroFinal: \"\",\n        Estado: \"\",\n        configuracion: [],\n      };\n    },\n    guardar() {\n      this.timbrado.configuracion = this.token_configracion;\n      if (this.editedIndex) {\n        this.$store\n          .dispatch(\"insertTimbrado\", this.timbrado)\n          .then((result) => {\n            console.log(\"Good job\");\n            this.timbrado = this.createFreshTimbrado();\n          })\n          .catch((err) => {\n            console.log(\"Bad! this is sad\");\n          });\n      }else{\n        console.log(\"Enviando datos pra editar\")\n        this.$store\n          .dispatch(\"updateTimbrado\", this.timbrado)\n          .then((result) => {\n            console.log(\"Good job\");\n            this.timbrado = this.createFreshTimbrado();\n          })\n          .catch((err) => {\n            console.log(\"Bad! this is sad\");\n          });\n      }\n    },\n    editItem(item) {\n      this.timbrado = item;\n      console.log(this.timbrado);\n      this.dialog = true;\n      this.editedIndex = false;\n    },\n    dialogoReset(){\n      this.dialog = false;\n      this.editedIndex = true;\n      this.timbrado = this.createFreshTimbrado();\n    }\n  },\n};\n",{"version":3,"sources":["Timbrado.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAgNA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Timbrado.vue","sourceRoot":"src/components/referenciales-facturas","sourcesContent":["<template>\n  <v-layout align-start>\n    <v-flex>\n      <v-toolbar float color=\"white\">\n        <v-toolbar-title>Timbrados</v-toolbar-title>\n        <v-divider class=\"mx-2\" insert vertical></v-divider>\n        <v-spacer></v-spacer>\n        <v-text-field\n          class=\"text-xs-center\"\n          v-model=\"search\"\n          append-icon=\"search\"\n          label=\"Búsqueda\"\n          single-line\n          hide-details\n        ></v-text-field>\n        <v-spacer></v-spacer>\n\n        <!-- Inicio Dialogo agregar  Timbrados -->\n        <v-dialog v-model=\"dialog\" max-width=\"1200px\">\n          <template v-slot:activator=\"{ on }\">\n            <v-btn color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">\n              Nuevo\n              <v-icon dark right>mdi-checkbox-marked-circle</v-icon>\n            </v-btn>\n          </template>\n          <v-card>\n            <v-card-title>\n              <!-- <span class=\"headline\">{{ formTitle }}</span> -->\n            </v-card-title>\n            <v-card-text>\n              <v-container grid-list-md>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md4>\n                    <v-text-field v-show='editedIndex' v-model=\"timbrado.NumeroTimbrado\" label=\"Número Timbrado\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm12 md4>\n                    <v-autocomplete\n                      :items=\"sucursales.sucursales\"\n                      v-model=\"timbrado.CodigoSucursal\"\n                      item-text=\"Nombre\"\n                      item-value=\"CodigoSucursal\"\n                      label=\"Sucursal\"\n                    ></v-autocomplete>\n                  </v-flex>\n                  <v-flex xs12 sm12 md4>\n                    <v-autocomplete\n                      :items=\"tipoDocumento.tipoDocumentos\"\n                      v-model=\"timbrado.CodigoTiposDocumento\"\n                      item-text=\"Descripcion\"\n                      item-value=\"Codigo\"\n                      label=\"Tipos de Documento\"\n                    ></v-autocomplete>\n                  </v-flex>\n                </v-layout>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md4>\n                    <v-text-field v-model=\"timbrado.PuntoExpedicion\" label=\"Punto de Expedicion\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm12 md4>\n                    <v-text-field v-model=\"timbrado.NumeroInicial\" label=\"Número Inicial\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm12 md4>\n                    <v-text-field v-model=\"timbrado.NumeroFinal\" label=\"Punto Final\"></v-text-field>\n                  </v-flex>\n                </v-layout>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md6>\n                    <v-menu\n                      ref=\"menu\"\n                      v-model=\"menu\"\n                      :close-on-content-click=\"false\"\n                      :return-value.sync=\"timbrado.FechaInicioVigencia\"\n                      transition=\"scale-transition\"\n                      offset-y\n                      min-width=\"290px\"\n                    >\n                      <template v-slot:activator=\"{ on, attrs }\">\n                        <v-text-field\n                          v-model=\"timbrado.FechaInicioVigencia\"\n                          label=\"Fecha inicio vigencia\"\n                          prepend-icon=\"event\"\n                          readonly\n                          v-bind=\"attrs\"\n                          v-on=\"on\"\n                        ></v-text-field>\n                      </template>\n                      <v-date-picker v-model=\"timbrado.FechaInicioVigencia\" no-title scrollable>\n                        <v-spacer></v-spacer>\n                        <v-btn text color=\"primary\" @click=\"dialog = false\">Cancel</v-btn>\n                        <v-btn\n                          text\n                          color=\"primary\"\n                          @click=\"$refs.menu.save(timbrado.FechaInicioVigencia)\"\n                        >OK</v-btn>\n                      </v-date-picker>\n                    </v-menu>\n                  </v-flex>\n                  <v-flex xs12 sm12 md6>\n                    <v-menu\n                      ref=\"menu2\"\n                      v-model=\"menu2\"\n                      :close-on-content-click=\"false\"\n                      :return-value.sync=\"timbrado.FechaFinVigencia\"\n                      transition=\"scale-transition\"\n                      offset-y\n                      min-width=\"290px\"\n                    >\n                      <template v-slot:activator=\"{ on, attrs }\">\n                        <v-text-field\n                          v-model=\"timbrado.FechaFinVigencia\"\n                          label=\"Fecha fin vigencia\"\n                          prepend-icon=\"event\"\n                          readonly\n                          v-bind=\"attrs\"\n                          v-on=\"on\"\n                        ></v-text-field>\n                      </template>\n                      <v-date-picker v-model=\"timbrado.FechaFinVigencia\" no-title scrollable>\n                        <v-spacer></v-spacer>\n                        <v-btn text color=\"primary\" @click=\"menu2 = false\">Cancel</v-btn>\n                        <v-btn\n                          text\n                          color=\"primary\"\n                          @click=\"$refs.menu2.save(timbrado.FechaFinVigencia)\"\n                        >OK</v-btn>\n                      </v-date-picker>\n                    </v-menu>\n                  </v-flex>\n                </v-layout>\n\n                <v-flex xs12 sm12 md12>\n                  <!-- <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div> -->\n                  <v-checkbox v-model=\"timbrado.Estado\" label=\"Estado\"></v-checkbox>\n                </v-flex>\n              </v-container>\n            </v-card-text>\n            <v-card-actions>\n              <v-spacer></v-spacer>\n              <v-btn class=\"mb-2\" dark color=\"red accent-3\" @click=\"dialogoReset()\">\n                Cancelar\n                <v-icon dark right>mdi-cancel</v-icon>\n              </v-btn>\n              <v-btn color=\"green darken-3\" class=\"mb-2\" dark @click=\"guardar()\">\n                Guardar\n                <v-icon dark right>mdi-checkbox-marked-circle</v-icon>\n              </v-btn>\n            </v-card-actions>\n          </v-card>\n        </v-dialog>\n        <!-- Fin Dialogo agregar Timbrados -->\n      </v-toolbar>\n      <v-data-table\n        :headers=\"headers\"\n        :items=\"timbrados.timbrados\"\n        :search=\"search\"\n        class=\"elevation-1\"\n      >\n        <template v-slot:items=\"props\">\n          <td class=\"justify-center layout px-0\">\n            <template>\n              <v-btn\n                class=\"mx-2\"\n                fab\n                dark\n                small\n                color=\"amber darken-4\"\n                @click=\"editItem(props.item)\"\n              >\n                <v-icon dark>mdi-pencil</v-icon>\n              </v-btn>\n            </template>\n\n            <template>\n              <v-btn\n                class=\"mx-2\"\n                fab\n                dark\n                small\n                color=\"purple darken-1\"\n                @click=\"listarprecio(props.item)\"\n              >\n                <v-icon dark>mdi-wrench</v-icon>\n              </v-btn>\n            </template>\n          </td>\n          <td>{{ props.item.NumeroTimbrado }}</td>\n          <td>{{ props.item.CodigoSucursal }}</td>\n          <td>{{ props.item.PuntoExpedicion }}</td>\n          <td>{{ props.item.FechaInicioVigencia }}</td>\n          <td>{{props.item.FechaFinVigencia}}</td>\n          <!-- <td>{{ props.item.StockActual }}</td>\n          <td>{{ props.item.StockMinimo }}</td>\n          <td>{{ props.item.Marca}}</td>\n          <td>{{ props.item.Categoria}}</td>\n          <td>{{ props.item.Impuesto}}</td>\n          <td>{{ props.item.Deposito}}</td>-->\n\n          <td></td>\n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n\n<script>\nimport { mapState } from \"vuex\";\nexport default {\n  data() {\n    return {\n      search: \"\",\n      headers: [\n        { text: \"Opciones\", value: \"opciones\" },\n        { text: \"N° Timbrado\", value: \"NumeroTimbrado\" },\n        { text: \"Código Sucursal\", value: \"CodigoSucursal\" },\n        { text: \"Punto de Expedición\", value: \"PuntoExpedicion\" },\n        { text: \"Fecha inicio Vigencia\", value: \"FechaInicioVigencia\" },\n        { text: \"Fecha fin vigencia\", value: \"FechaFinVigencia\" },\n      ],\n      timbrado: this.createFreshTimbrado(),\n      menu: false,\n      menu2: false,\n      dialog: false,\n      token_configracion: [],\n      editedIndex: true,\n    };\n  },\n  name: \"ListadoTimbrado\",\n  mounted() {\n    let header = { \"auth-token\": this.$store.state.token };\n    let configuracion = { headers: header };\n    this.token_configracion = configuracion;\n    this.$store.dispatch(\"getTimbrados\", configuracion);\n    this.$store.dispatch(\"getSucursales\", configuracion);\n    this.$store.dispatch(\"getTipoDocumentos\", configuracion);\n  },\n  computed: {\n    ...mapState([\"timbrados\", \"sucursales\", \"tipoDocumento\"]),\n  },\n  methods: {\n    createFreshTimbrado() {\n      return {\n        NumeroTimbrado: \"\",\n        CodigoSucursal: \"\",\n        PuntoExpedicion: \"\",\n        CodigoTiposDocumento: \"\",\n        FechaInicioVigencia: new Date().toISOString().substr(0, 10),\n        FechaFinVigencia: new Date().toISOString().substr(0, 10),\n        NumeroInicial: \"\",\n        NumeroFinal: \"\",\n        Estado: \"\",\n        configuracion: [],\n      };\n    },\n    guardar() {\n      this.timbrado.configuracion = this.token_configracion;\n      if (this.editedIndex) {\n        this.$store\n          .dispatch(\"insertTimbrado\", this.timbrado)\n          .then((result) => {\n            console.log(\"Good job\");\n            this.timbrado = this.createFreshTimbrado();\n          })\n          .catch((err) => {\n            console.log(\"Bad! this is sad\");\n          });\n      }else{\n        console.log(\"Enviando datos pra editar\")\n        this.$store\n          .dispatch(\"updateTimbrado\", this.timbrado)\n          .then((result) => {\n            console.log(\"Good job\");\n            this.timbrado = this.createFreshTimbrado();\n          })\n          .catch((err) => {\n            console.log(\"Bad! this is sad\");\n          });\n      }\n    },\n    editItem(item) {\n      this.timbrado = item;\n      console.log(this.timbrado);\n      this.dialog = true;\n      this.editedIndex = false;\n    },\n    dialogoReset(){\n      this.dialog = false;\n      this.editedIndex = true;\n      this.timbrado = this.createFreshTimbrado();\n    }\n  },\n};\n</script>"]}]}