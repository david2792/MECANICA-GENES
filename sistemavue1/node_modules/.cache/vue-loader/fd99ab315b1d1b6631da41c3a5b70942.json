echaFinVigencia: new Date().toISOString().substr(0, 10),\r\n        NumeroInicial: \"\",\r\n        NumeroFinal: \"\",\r\n        Estado: \"\",\r\n        configuracion: [],\r\n      };\r\n    },\r\n    guardar() {\r\n      this.timbrado.configuracion = this.token_configracion;\r\n      if (this.editedIndex) {\r\n        this.$store\r\n          .dispatch(\"insertTimbrado\", this.timbrado)\r\n          .then((result) => {\r\n            console.log(\"Good job\");\r\n            this.timbrado = this.createFreshTimbrado();\r\n          })\r\n          .catch((err) => {\r\n            console.log(\"Bad! this is sad\");\r\n          });\r\n      }else{\r\n        console.log(\"Enviando datos pra editar\")\r\n        this.$store\r\n          .dispatch(\"updateTimbrado\", this.timbrado)\r\n          .then((result) => {\r\n            console.log(\"Good job\");\r\n            this.timbrado = this.createFreshTimbrado();\r\n          })\r\n          .catch((err) => {\r\n            console.log(\"Bad! this is sad\");\r\n          });\r\n      }\r\n    },\r\n    editItem(item) {\r\n      this.timbrado = item;\r\n      console.log(this.timbrado);\r\n      this.dialog = true;\r\n      this.editedIndex = false;\r\n    },\r\n    dialogoReset(){\r\n      this.dialog = false;\r\n      this.editedIndex = true;\r\n      this.timbrado = this.createFreshTimbrado();\r\n    }\r\n  },\r\n};\r\n</script>"]}]}