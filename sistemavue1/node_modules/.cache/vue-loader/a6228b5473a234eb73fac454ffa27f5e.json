ortable: true },\r\n        { text: \"Nombre\", value: \"Nombre\", sortable: false },\r\n        { text: \"Departamento\", value: \"Departamento\", sortable: false }\r\n      ],\r\n      dialogoConfirmacion: false,\r\n      editedIndex: -1,\r\n      CodigoCiudad: \"\",\r\n      Nombre: \"\",\r\n      Departamento:'',\r\n      validaMensaje: [],\r\n      valida: 0,\r\n      adModal: 0,\r\n      adAccion: 0,\r\n      adNombre: \"\",\r\n      adId: \"\"\r\n    };\r\n  },\r\n  computed: {\r\n    formTitle() {\r\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\r\n    }\r\n  },\r\n  watch: {\r\n    dialog(val) {\r\n      val || this.close();\r\n    }\r\n  },\r\n  created() {\r\n    this.listar();\r\n    this.selectDepartamento();\r\n  },\r\n  methods: {\r\n    listar() {\r\n      let me = this;\r\n      let header={\"auth-token\":this.$store.state.token};\r\n      let configuracion={headers:header};\r\n      axios\r\n        .get(\"ciudades/\",configuracion)\r\n        .then(function(response) {\r\n          me.ciudades = response.data;\r\n          console.log(ciudades)\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n      selectDepartamento() {\r\n      let me = this;\r\n      let depaArray = [];\r\n      let header = { \"auth-token\": this.$store.state.token };\r\n      let configuracion = { headers: header };\r\n      axios\r\n        .get(\"departamentos/\", configuracion)\r\n        .then(function(response) {\r\n          depaArray = response.data;\r\n          // console.log(categoriaArray)\r\n          depaArray.map(function(x) {\r\n            me.Departamentos.push({\r\n              text: x.Nombre,\r\n              value: x.CodigoDepartamento\r\n            });\r\n          });\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    limpiar() {\r\n      this.Nombre = \"\";\r\n      this.Departamento='';\r\n      this.editedIndex = -1;\r\n    },\r\n    validar() {\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      if (this.Nombre.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El nombre de la Ciudad debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n       if (this.Departamento.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El nombre del Departamento debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n      if (this.validaMensaje.length) {\r\n        this.valida = 1;\r\n      }\r\n      return this.valida;\r\n    },\r\n    guardar() {\r\n      let header = { \"auth-token\": this.$store.state.token };\r\n      let configuracion = { headers: header };\r\n      let me = this;\r\n      if (this.validar()) {\r\n        return;\r\n      }\r\n      if (this.editedIndex > -1) {\r\n        //Código para editar\r\n        axios\r\n          .put(\"ciudades/\", {\r\n            CodigoCiudad: this.CodigoCiudad,\r\n            Nombre: this.Nombre,\r\n            Departamento:this.Departamento\r\n          },configuracion)\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      } else {\r\n        axios\r\n          .post(\"ciudades/\", { Nombre: this.Nombre,Departamento:this.Departamento},configuracion)\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      }\r\n    },\r\n    editItem(item) {\r\n      this.CodigoCiudad = item.CodigoCiudad;\r\n      this.Nombre = item.Ciudad;\r\n      this.Departamento = item.Departamento;\r\n      this.dialog = true;\r\n      this.editedIndex = 1;\r\n    },\r\n\r\n    activarDesactivarCerrar() {\r\n      this.adModal = 0;\r\n    },\r\n\r\n    close() {\r\n      this.dialog = false;\r\n    }\r\n  }\r\n};\r\n",{"version":3,"sources":["Ciudad.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoGA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"Ciudad.vue","sourceRoot":"src/components/referenciales-localidades","sourcesContent":["<template>\r\n  <v-layout align-start>\r\n    <v-flex>\r\n      <v-toolbar flat color=\"white\">\r\n        <v-toolbar-title>Ciudad</v-toolbar-title>\r\n        <v-divider class=\"mx-2\" inset vertical></v-divider>\r\n        <v-spacer></v-spacer>\r\n        <v-text-field\r\n          class=\"text-xs-center\"\r\n          v-model=\"search\"\r\n          append-icon=\"search\"\r\n          label=\"Búsqueda\"\r\n          single-line\r\n          hide-details\r\n        ></v-text-field>\r\n        <v-spacer></v-spacer>\r\n        <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n          <template v-slot:activator=\"{ on }\">\r\n            <v-btn  color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\r\n          </template>\r\n          <v-card>\r\n            <v-card-title>\r\n              <span class=\"headline\">{{ formTitle }}</span>\r\n            </v-card-title>\r\n            <v-card-text>\r\n              <v-container grid-list-md>\r\n                <v-layout wrap>\r\n                  <v-flex xs12 sm12 md12>\r\n                    <v-text-field v-model=\"Nombre\" label=\"Nombre\"></v-text-field>\r\n                  </v-flex>\r\n                </v-layout>\r\n                 <v-layout wrap>\r\n                  <v-flex xs12 sm12 md12>\r\n                    <v-autocomplete\r\n                      :items=\"Departamentos\"\r\n                      v-model=\"Departamento\"\r\n                      item-value=\"Departamento\"\r\n                      label=\"Departamentos\"\r\n                    ></v-autocomplete>\r\n                  </v-flex>\r\n                </v-layout>\r\n                <v-flex xs12 sm12 md12 v-show=\"valida\">\r\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\r\n                </v-flex>\r\n              </v-container>\r\n            </v-card-text>\r\n            <v-card-actions>\r\n              <v-spacer></v-spacer>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\r\n            </v-card-actions>\r\n          </v-card>\r\n        </v-dialog>\r\n                <!-- dialogo confirmacion -->\r\n        <template>\r\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\r\n            <v-card dark color=\"blue lighten-3\">\r\n              <v-card-title class=\"headline\">\r\n                <v-img\r\n                  class=\"white--text align-end\"\r\n                  :src=\"require('../../assets/ok.png')\"\r\n                  contain\r\n                  height=\"100\"\r\n                ></v-img>\r\n              </v-card-title>\r\n              <center>\r\n                <v-card-text>\r\n                  <h3 class=\"white--text align-end\">Se agrego la Ciudad</h3>\r\n                </v-card-text>\r\n              </center>\r\n              <v-card-actions>\r\n                <v-spacer></v-spacer>\r\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\r\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\r\n              </v-card-actions>\r\n            </v-card>\r\n          </v-dialog>\r\n        </template>\r\n        <!-- fin dialogo -->\r\n      </v-toolbar>\r\n      <v-data-table :headers=\"headers\" :items=\"ciudades\" :search=\"search\" class=\"elevation-1\">\r\n        <template v-slot:items=\"props\">\r\n          <td class=\"justify-center layout px-0\">\r\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\r\n              <v-icon dark>mdi-pencil</v-icon>\r\n            </v-btn>\r\n          </td>\r\n          <td>{{ props.item.CodigoCiudad }}</td>\r\n          <td>{{ props.item.Ciudad }}</td>\r\n          <td>{{ props.item.Departamento }}</td>\r\n          <td></td>\r\n        </template>\r\n        <template v-slot:no-data>\r\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-flex>\r\n  </v-layout>\r\n</template>\r\n<script>\r\nimport axios from \"axios\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      dialog: false,\r\n      search: \"\",\r\n      Departamentos: [],\r\n      ciudades:[],\r\n      headers: [\r\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\r\n        { text: \"Codigo\", value: \"CodigoCiudad\", sortable: true },\r\n        { text: \"Nombre\", value: \"Nombre\", sortable: false },\r\n        { text: \"Departamento\", value: \"Departamento\", sortable: false }\r\n      ],\r\n      dialogoConfirmacion: false,\r\n      editedIndex: -1,\r\n      CodigoCiudad: \"\",\r\n      Nombre: \"\",\r\n      Departamento:'',\r\n      validaMensaje: [],\r\n      valida: 0,\r\n      adModal: 0,\r\n      adAccion: 0,\r\n      adNombre: \"\",\r\n      adId: \"\"\r\n    };\r\n  },\r\n  computed: {\r\n    formTitle() {\r\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\r\n    }\r\n  },\r\n  watch: {\r\n    dialog(val) {\r\n      val || this.close();\r\n    }\r\n  },\r\n  created() {\r\n    this.listar();\r\n    this.selectDepartamento();\r\n  },\r\n  methods: {\r\n    listar() {\r\n      let me = this;\r\n      let header={\"auth-token\":this.$store.state.token};\r\n      let configuracion={headers:header};\r\n      axios\r\n        .get(\"ciudades/\",configuracion)\r\n        .then(function(response) {\r\n          me.ciudades = response.data;\r\n          console.log(ciudades)\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n      selectDepartamento() {\r\n      let me = this;\r\n      let depaArray = [];\r\n      let header = { \"auth-token\": this.$store.state.token };\r\n      let configuracion = { headers: header };\r\n      axios\r\n        .get(\"departamentos/\", configuracion)\r\n        .then(function(response) {\r\n          depaArray = response.data;\r\n          // console.log(categoriaArray)\r\n          depaArray.map(function(x) {\r\n            me.Departamentos.push({\r\n              text: x.Nombre,\r\n              value: x.CodigoDepartamento\r\n            });\r\n          });\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    limpiar() {\r\n      this.Nombre = \"\";\r\n      this.Departamento='';\r\n      this.editedIndex = -1;\r\n    },\r\n    validar() {\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      if (this.Nombre.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El nombre de la Ciudad debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n       if (this.Departamento.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El nombre del Departamento debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n      if (this.validaMensaje.length) {\r\n        this.valida = 1;\r\n      }\r\n      return this.valida;\r\n    },\r\n    guardar() {\r\n      let header = { \"auth-token\": this.$store.state.token };\r\n      let configuracion = { headers: header };\r\n      let me = this;\r\n      if (this.validar()) {\r\n        return;\r\n      }\r\n      if (this.editedIndex > -1) {\r\n        //Código para editar\r\n        axios\r\n          .put(\"ciudades/\", {\r\n            CodigoCiudad: this.CodigoCiudad,\r\n            Nombre: this.Nombre,\r\n            Departamento:this.Departamento\r\n          },configuracion)\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      } else {\r\n        axios\r\n          .post(\"ciudades/\", { Nombre: this.Nombre,Departamento:this.Departamento},configuracion)\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      }\r\n    },\r\n    editItem(item) {\r\n      this.CodigoCiudad = item.CodigoCiudad;\r\n      this.Nombre = item.Ciudad;\r\n      this.Departamento = item.Departamento;\r\n      this.dialog = true;\r\n      this.editedIndex = 1;\r\n    },\r\n\r\n    activarDesactivarCerrar() {\r\n      this.adModal = 0;\r\n    },\r\n\r\n    close() {\r\n      this.dialog = false;\r\n    }\r\n  }\r\n};\r\n</script>\r\n"]}]}