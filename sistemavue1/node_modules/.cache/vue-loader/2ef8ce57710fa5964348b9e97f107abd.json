     </v-flex>\r\n              <!-- Fecha desde -->\r\n              <v-col sm6 md6>\r\n                <v-menu\r\n                  ref=\"menu\"\r\n                  v-model=\"menu\"\r\n                  :close-on-content-click=\"false\"\r\n                  :return-value.sync=\"recepcionvehiculos.fechaDesde\"\r\n                  transition=\"scale-transition\"\r\n                  offset-y\r\n                  min-width=\"290px\"\r\n                >\r\n                  <template v-slot:activator=\"{ on }\">\r\n                    <v-text-field\r\n                      v-model=\"recepcionvehiculos.fechaDesde\"\r\n                      label=\"Fecha Desde\"\r\n                      v-on=\"on\"\r\n                    ></v-text-field>\r\n                  </template>\r\n                  <v-date-picker\r\n                    locale=\"Py\"\r\n                    v-model=\"recepcionvehiculos.fechaDesde\"\r\n                    no-title\r\n                    scrollable\r\n                  >\r\n                    <v-spacer></v-spacer>\r\n                    <v-btn text color=\"primary\" @click=\"menu = false\"\r\n                      >Cancel</v-btn\r\n                    >\r\n                    <v-btn\r\n                      text\r\n                      color=\"primary\"\r\n                      @click=\"$refs.menu.save(recepcionvehiculos.fechaDesde, filtrar())\"\r\n                      >OK</v-btn\r\n                    >\r\n                  </v-date-picker>\r\n                </v-menu>\r\n              </v-col>\r\n              <!-- fin fecha desde -->\r\n              <v-spacer></v-spacer>\r\n              <!-- Fecha hasta -->\r\n              <v-col sm6 md6>\r\n                <v-menu\r\n                  ref=\"menu1\"\r\n                  v-model=\"menu1\"\r\n                  :close-on-content-click=\"false\"\r\n                  :return-value.sync=\"recepcionvehiculos.fechaHasta\"\r\n                  transition=\"scale-transition\"\r\n                 