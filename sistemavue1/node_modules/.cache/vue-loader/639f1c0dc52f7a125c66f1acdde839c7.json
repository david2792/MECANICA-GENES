ccion: 0,\r\n      adNombre: \"\",\r\n      adId: \"\"\r\n    };\r\n  }, \r\n  computed: {\r\n    formTitle() {\r\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\r\n    }\r\n  },\r\n  watch: {\r\n    dialog(val) {\r\n      val || this.close();\r\n    }\r\n  },\r\n  created() {\r\n    this.listar();\r\n  },\r\n  methods: {\r\n    listar() {\r\n      let idproducto = this.$route.params.id;\r\n      let descri = this.$route.params.descripcion;\r\n      let me = this;\r\n      axios\r\n        .get(\"listasprecios/\" + idproducto + \"\")\r\n        .then(function(response) {\r\n          me.lista = response.data;\r\n          console.log(descri);\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    limpiar() {\r\n      this.Descripcion = \"\";\r\n      this.Precio = \"\";\r\n      this.Cuotas = \"\";\r\n      this.editedIndex = -1;\r\n    },\r\n    validar() {\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      if (this.Descripcion.length < 1 || this.Descripcion.length > 50) {\r\n        this.validaMensaje.push(\r\n          \"El nombre de la marca debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n      if (this.Descripcion.length > 255) {\r\n        this.validaMensaje.push(\r\n          \"La descripción de la marca no debe tener más de 255 caracteres.\"\r\n        );\r\n      }\r\n      if (this.validaMensaje.length) {\r\n        this.valida = 1;\r\n      }\r\n      return this.valida;\r\n    },\r\n    actualizar() {\r\n      let me = this;\r\n      console.log(this.Descripcion)\r\n      axios\r\n        .put(\"listasprecios/actualizar\", {\r\n          Codigo: this.Codigo,\r\n          codigoproducto: this.codigoproducto,\r\n          Descripcion: this.Descripcion,\r\n          Precio: this.Precio,\r\n          Cuotas: this.Cuotas\r\n        })\r\n        .then(function(response) {\r\n          me.limpiar();\r\n          me.close();\r\n          me.listar();\r\n          me.dialogoConfirmacion = true;\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    guardar() {\r\n      let me = this;\r\n      if (this.validar()) {\r\n        return;\r\n      }\r\n      if (this.editedIndex > -1) {\r\n      } else {\r\n        axios\r\n          .post(\"listasprecios/\", {\r\n            depo: this.depo,\r\n            codigoproducto: this.codigoproducto,\r\n            Descripcion: this.Descripcion,\r\n            Precio: this.Precio,\r\n            Cuotas: this.Cuotas\r\n          })\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      }\r\n    },\r\n    desactivarLista(item) {\r\n      let me = this;\r\n      this.Codigo = item.Codigo;\r\n      this.Estado = item.Estado;\r\n      console.log(this.Codigo);\r\n      axios\r\n        .put(\"listasprecios/\", { Codigo: this.Codigo, Estado: this.Estado })\r\n        .then(function(response) {\r\n          me.listar();\r\n          console.log(\"paso\");\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n          console.log(\"error\");\r\n        });\r\n    },\r\n    editItem(item) {\r\n      this.Codigo = item.Codigo;\r\n      this.Descripcion = item.Descripcion;\r\n      this.Precio = item.Precio;\r\n      console.log(item.Cuotas);\r\n      this.Cuotas = item.Cuotas;\r\n      this.dialog = true;\r\n      this.editedIndex = 1;\r\n    },\r\n    activarDesactivarCerrar() {\r\n      this.adModal = 0;\r\n    },\r\n    close() {\r\n      this.dialog = false;\r\n    },\r\n    close2() {\r\n      this.dialogoConfirmacion = false;\r\n    }\r\n  }\r\n};\r\n</script>\r\n"]}]}