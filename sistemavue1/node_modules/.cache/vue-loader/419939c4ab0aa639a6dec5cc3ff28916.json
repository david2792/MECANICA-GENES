odigo\", sortable: true },\n        { text: \"Descripción\", value: \"nombre\", sortable: false }\n      ],\n      editedIndex: -1,\n      dialogoConfirmacion:false,\n      codigo: \"\",\n      nombre: \"\",\n      validaMensaje: [],\n      valida:'',\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n  },\n  methods: {\n    listar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      axios\n        .get(\"anios/\",configuracion)\n        .then(function(response) {\n          me.categorias = response.data;\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.nombre = \"\";\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.nombre.length < 1) {\n        this.validaMensaje.push(\n          \"El nombre de la recepcion debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n    guardar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.codigo, this.nombre);\n        axios\n          .put(\"anios/\", {\n            codigo: this.codigo,\n            nombre: this.nombre\n          },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        axios\n          .post(\"anios/\", { nombre: this.nombre },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.codigo = item.codigo;\n      this.nombre = item.nombre;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n\n    close() {\n      this.dialog = false;\n    }\n  }\n};\n",{"version":3,"sources":["Anio.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwFA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"Anio.vue","sourceRoot":"src/components/referenciales-taller","sourcesContent":["<template>\n  <v-layout align-start>\n    <v-flex>\n      <v-toolbar flat color=\"white\">\n        <v-toolbar-title>Años</v-toolbar-title>\n        <v-divider class=\"mx-2\" inset vertical></v-divider>\n        <v-spacer></v-spacer>\n        <v-text-field\n          class=\"text-xs-center\"\n          v-model=\"search\"\n          append-icon=\"search\"\n          label=\"Búsqueda\"\n          single-line\n          hide-details\n        ></v-text-field>\n        <v-spacer></v-spacer>\n        <v-dialog v-model=\"dialog\" max-width=\"500px\">\n          <template v-slot:activator=\"{ on }\">\n            <v-btn color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\n          </template>\n          <v-card>\n            <v-card-title>\n              <span class=\"headline\">{{ formTitle }}</span>\n            </v-card-title>\n            <v-card-text>\n              <v-container grid-list-md>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md12>\n                    <v-text-field v-model=\"nombre\" label=\"Descripción\"></v-text-field>\n                  </v-flex>\n                </v-layout>\n                <v-flex xs12 sm12 md12 v-show=\"valida\">\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\n                </v-flex>\n              </v-container>\n            </v-card-text>\n            <v-card-actions>\n              <v-spacer></v-spacer>\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\n            </v-card-actions>\n          </v-card>\n        </v-dialog>\n       <template>\n           <!-- confirmacion -->\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\n            <v-card dark color=\"blue lighten-3\">\n              <v-card-title class=\"headline\">\n                <v-img\n                  class=\"white--text align-end\"\n                  :src=\"require('../../assets/ok.png')\"\n                  contain\n                  height=\"100\"\n                ></v-img>\n              </v-card-title>\n              <center>\n                <v-card-text>\n                  <h3 class=\"white--text align-end\">REGISTRO GUARDADO</h3>\n                </v-card-text>\n              </center>\n              <v-card-actions>\n                <v-spacer></v-spacer>\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\n              </v-card-actions>\n            </v-card>\n          </v-dialog>\n        </template>\n      </v-toolbar>\n      <v-data-table :headers=\"headers\" :items=\"categorias\" :search=\"search\" class=\"elevation-1\">\n        <template v-slot:items=\"props\">\n          <td class=\"justify-center layout px-0\">\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon>\n            </v-btn>\n          </td>\n          <td>{{ props.item.codigo }}</td>\n          <td>{{ props.item.nombre }}</td>\n          <td></td>\n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n<script>\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      dialog: false,\n      search: \"\",\n      categorias: [],\n      headers: [\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\n        { text: \"Codigo\", value: \"codigo\", sortable: true },\n        { text: \"Descripción\", value: \"nombre\", sortable: false }\n      ],\n      editedIndex: -1,\n      dialogoConfirmacion:false,\n      codigo: \"\",\n      nombre: \"\",\n      validaMensaje: [],\n      valida:'',\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n  },\n  methods: {\n    listar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      axios\n        .get(\"anios/\",configuracion)\n        .then(function(response) {\n          me.categorias = response.data;\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.nombre = \"\";\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.nombre.length < 1) {\n        this.validaMensaje.push(\n          \"El nombre de la recepcion debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n    guardar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.codigo, this.nombre);\n        axios\n          .put(\"anios/\", {\n            codigo: this.codigo,\n            nombre: this.nombre\n          },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        axios\n          .post(\"anios/\", { nombre: this.nombre },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.codigo = item.codigo;\n      this.nombre = item.nombre;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n\n    close() {\n      this.dialog = false;\n    }\n  }\n};\n</script>"]}]}