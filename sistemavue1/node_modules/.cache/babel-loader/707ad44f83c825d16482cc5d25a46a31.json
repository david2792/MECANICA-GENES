n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport axios from \"axios\";\nexport default {\n  data: function data() {\n    return {\n      dialog: false,\n      search: \"\",\n      impuestos: [],\n      headers: [{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"CodigImpuesto\",\n        sortable: true\n      }, {\n        text: \"Descripción\",\n        value: \"Descripcion\",\n        sortable: false\n      }, {\n        text: \"Porcentaje\",\n        value: \"Porcentaje\",\n        sortable: false\n      }, {\n        text: \"Dividir\",\n        value: \"DividirPor\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      CodigImpuesto: \"\",\n      Descripcion: \"\",\n      Porcentaje: \"\",\n      DividirPor: \"\",\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"impuestos/\").then(function (response) {\n        me.impuestos = response.data;\n      }, configuracion).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = \"\";\n      this.Porcentaje = \"\";\n      this.DividirPor = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Descripcion.length < 1) {\n        this.validaMensaje.push(\"El nombre del Impuesto debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Porcentaje.length < 1) {\n        this.validaMensaje.push(\"Ingrese el porcentaje.\");\n      }\n\n      if (this.DividirPor.length < 1) {\n        this.validaMensaje.push(\"Ingrese el divisor\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        axios.put(\"impuestos/\", {\n          CodigImpuesto: this.CodigImpuesto,\n          Descripcion: this.Descripcion,\n          Porcentaje: this.Porcentaje,\n          DividirPor: this.DividirPor\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        console.log(this.CodigImpuesto, this.Descripcion, this.Porcentaje);\n        axios.post(\"impuestos/\", {\n          Descripcion: this.Descripcion,\n          Porcentaje: this.Porcentaje,\n          DividirPor: this.DividirPor\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigImpuesto = item.CodigImpuesto;\n      this.Descripcion = item.Descripcion;\n      this.Porcentaje = item.Porcentaje;\n      this.DividirPor = item.DividirPor;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.Descripcion;\n      this.adPorentaje = item.Porcentaje;\n      this.adDividir = item.DividirPor;\n      this.adId = item.CodigImpuesto;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    activar: function activar() {\n      var me = this;\n      axios.put(\"impuestos/\", {\n        CodigImpuesto: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adSimbolo = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    desactivar: function desactivar() {\n      var me = this;\n      axios.put(\"impuestos/deactivate\", {\n        _id: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    close: function close() {\n      this.dialog = false;\n    }\n  }\n};",{"version":3,"sources":["Impuesto.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAuGA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,SAAA,EAAA,EAHA;AAIA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;A