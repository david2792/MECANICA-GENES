 return {\n      dialog: false,\n      dialogoConfirmacion: false,\n      search: \"\",\n      lista: [],\n      headers: [{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"Codigo\",\n        sortable: true\n      }, {\n        text: \"Codigo Producto\",\n        value: \"CodigoProducto\",\n        sortable: false\n      }, {\n        text: \"Descripcion\",\n        value: \"Descripcion\",\n        sortable: false\n      }, {\n        text: \"Cuotas\",\n        value: \"Cuotas\",\n        sortable: false\n      }, {\n        text: \"Precio Compra\",\n        value: \"PrecioCompra\",\n        sortable: false\n      }, {\n        text: \"Deposito\",\n        value: \"Nombre\",\n        sortable: false\n      }, {\n        text: \"Estado\",\n        value: \"Estado\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      Codigo: \"\",\n      Estado: \"DESABILITADO\",\n      CodigoProducto: \"\",\n      CodigoDeposito: \"\",\n      Descripcion: \"\",\n      Precio: \"\",\n      PrecioCompra: \"\",\n      Cuotas: \"\",\n      codigoproducto: this.$route.params.id,\n      descri: this.$route.params.descripcion,\n      depo: this.$route.params.deposito,\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var idproducto = this.$route.params.id;\n      var descri = this.$route.params.descripcion;\n      var me = this;\n      axios.get(\"listasprecios/\" + idproducto + \"\").then(function (response) {\n        me.lista = response.data;\n        console.log(descri);\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = \"\";\n      this.Precio = \"\";\n      this.Cuotas = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Descripcion.length < 1 || this.Descripcion.length > 50) {\n        this.validaMensaje.push(\"El nombre de la marca debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Descripcion.length > 255) {\n        this.validaMensaje.push(\"La descripción de la marca no debe tener más de 255 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    actualizar: function actualizar() {\n      var me = this;\n      console.log(this.Descripcion);\n      axios.put(\"listasprecios/actualizar\", {\n        Codigo: this.Codigo,\n        codigoproducto: this.codigoproducto,\n        Descripcion: this.Descripcion,\n        Precio: this.Precio,\n        Cuotas: this.Cuotas\n      }).then(function (response) {\n        me.limpiar();\n        me.close();\n        me.listar();\n        me.dialogoConfirmacion = true;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    guardar: function guardar() {\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {} else {\n        axios.post(\"listasprecios/\", {\n          depo: this.depo,\n          codigoproducto: this.codigoproducto,\n          Descripcion: this.Descripcion,\n          Precio: this.Precio,\n          Cuotas: this.Cuotas\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    desactivarLista: function desactivarLista(item) {\n      var me = this;\n      this.Codigo = item.Codigo;\n      this.Estado = item.Estado;\n      console.log(this.Codigo);\n      axios.put(\"listasprecios/\", {\n        Codigo: this.Codigo,\n        Estado: this.Estado\n      }).then(function (response) {\n        me.listar();\n        console.log(\"paso\");\n      }).catch(function (error) {\n        console.log(error);\n        console.log(\"error\");\n      });\n    },\n    editItem: function editItem(item) {\n      this.Codigo = item.Codigo;\n      this.Descripcion = item.Descripcion;\n      this.Precio = item.Precio;\n      console.log(item.Cuotas);\n      this.Cuotas = item.Cuotas;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    close: function close() {\n      this.dialog = false;\n    },\n    close2: function close2() {\n      this.dialogoConfirmacion = false;\n    }\n  }\n};",{"version":3,"sources":["Listaprecio.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqKA,OAAA,KAAA,MAAA,OAAA;AACA,OAAA,UAAA,MAAA,aAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,mBAAA,EAAA,KAFA;AAGA,MAAA,MAAA,EAAA,EAHA;AAIA,MAAA,KAAA,EAAA,EAJA;AAKA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,EAAA,iBAAA;AAAA,QAAA,KAAA,EAAA,gBAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAHA,EAIA;AAAA,QAAA,IAAA,EAAA,aAAA;AAAA,QAAA,KAAA,EAAA,aAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAJA,EAKA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OALA,EAMA;AAAA,QAAA,IAAA,EAAA,eAAA;AAAA,QAAA,KAAA,EAAA,cAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OANA,EAOA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,