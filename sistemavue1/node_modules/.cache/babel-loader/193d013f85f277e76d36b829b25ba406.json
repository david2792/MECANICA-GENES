data: function data() {\n    return {\n      dialog: false,\n      search: \"\",\n      personas: [],\n      headers: [{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"CodigoCliente\",\n        sortable: true\n      }, {\n        text: \"Razon Social\",\n        value: \"RazonSocial\",\n        sortable: true\n      }, {\n        text: \"Cedula\",\n        value: \"Cedula\",\n        sortable: true\n      }, {\n        text: \"RUC\",\n        value: \"Ruc\",\n        sortable: false\n      }, {\n        text: \"Dirección\",\n        value: \"Direccion\",\n        sortable: false\n      }, {\n        text: \"Teléfono\",\n        value: \"Telefono\",\n        sortable: false\n      }, {\n        text: \"Email\",\n        value: \"Email\",\n        sortable: false\n      }, {\n        text: \"Ciudad\",\n        value: \"Ciudad\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      RazonSocial: \"\",\n      CodigoCliente: '',\n      Cedula: \"\",\n      Ruc: \"\",\n      Direccion: \"\",\n      Telefono: \"\",\n      Ciudad: \"\",\n      Email: \"\",\n      Ciudades: [],\n      valida: 0,\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n    this.selectCiudad();\n  },\n  methods: {\n    listar: function listar() {\n      var me = this;\n      axios.get(\"clientes/\").then(function (response) {\n        me.personas = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Nombre = \"\";\n      this.RazonSocial = \"\";\n      this.Direccion = \"\";\n      this.Telefono = \"\";\n      this.Cedula = '';\n      this.Ruc = '';\n      this.Email = \"\";\n      this.Ciudad = '';\n      this.valida = 0;\n      this.validaMensaje = [];\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.RazonSocial.length < 1) {\n        this.validaMensaje.push(\"El nombre de la persona debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Cedula.length < 1) {\n        this.validaMensaje.push(\"El cedula no puede estar vacia.\");\n      }\n\n      if (this.Direccion.length < 1) {\n        this.validaMensaje.push(\"La dirección no puede estar vacia.\");\n      }\n\n      if (this.Telefono.length < 1) {\n        this.validaMensaje.push(\"El teléfono no  puede estar vacio.\");\n      }\n\n      if (this.Ciudad.length < 1) {\n        this.validaMensaje.push(\"La Ciudad del usuario no puede estar vacio.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    selectCiudad: function selectCiudad() {\n      var me = this;\n      var ciudadArray = [];\n      var header = {\n        Token: this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"ciudades/\", configuracion).then(function (response) {\n        ciudadArray = response.data;\n        ciudadArray.map(function (x) {\n          me.Ciudades.push({\n            text: x.Ciudad,\n            value: x.CodigoCiudad\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    guardar: function guardar() {\n      var me = this;\n      var header = {\n        Token: this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.Ciudad);\n        axios.put(\"clientes/\", {\n          CodigoCliente: this.CodigoCliente,\n          CodigoCiudad: this.CodigoCiudad,\n          RazonSocial: this.RazonSocial,\n          Cedula: this.Cedula,\n          Ruc: this.Ruc,\n          Ciudad: this.Ciudad,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        //Código para guardar\n        axios.post(\"clientes/\", {\n          CodigoCiudad: this.CodigoCiudad,\n          RazonSocial: this.RazonSocial,\n          Cedula: this.Cedula,\n          Ruc: this.Ruc,\n          Ciudad: this.Ciudad,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoCliente = item.CodigoCliente;\n      this.RazonSocial = item.RazonSocial;\n      this.Ruc = item.Ruc;\n      this.Cedula = item.Cedula;\n      this.Direccion = item.Direccion;\n      this.Telefono = item.Telefono;\n      this.Email = item.Email;\n      this.Ciudad = item.Ciudad;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.nombre;\n      this.adId = item._id;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    close: function close() {\n      this.dialog = false;\n      this.limpiar();\n    }\n  }\n};",{"version":3,"sources":["Cliente.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsHA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,QAAA,EAAA,EAHA;AAIA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,eAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,EAAA,cAAA;AAAA,QAAA,KAAA,EAAA,aAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAHA,EAIA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAJA,EAKA;AAAA,QAAA,IAAA,EAAA,KAAA;AAAA,QAAA,KAAA,EAAA,KAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OALA,EAMA;AAAA,QAAA,IAAA,EAAA,WAAA;AAAA,QAAA,KAAA,EAAA,WAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OANA,EAOA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAPA,EAQA;AAAA,QAAA,IAAA,EAAA,OAAA;AAAA,QAAA,KAAA,EAAA,OAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OARA,EASA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OATA,CAJA;AAeA,MAAA,WAAA,EAAA,CAAA,CAfA;AAgBA,MAAA,mBAAA,EAAA,KAhBA;AAiBA,MAAA,WAAA,EAAA,EAjBA;AAkBA,MAAA,aAAA,EAAA,EAlBA;AAmBA,MAAA,MAAA,EAAA,EAnBA;AAoBA,MAAA,GAAA,EAAA,EApBA;AAqBA,MAAA,SAAA,EAAA,EArBA;AAsBA,MAAA,QAAA,EAAA,EAtBA;AAuBA,MAAA,MAAA,EAAA,EAvBA;AAwBA,MAAA,KAAA,EAAA,EAxBA;AAyBA,MAAA,QAAA,EAAA,EAzBA;AA0BA,MAAA,MAAA,EAAA,CA1BA;AA2BA,MAAA,aAAA,EAAA,EA3BA;AA4BA,MAAA,OAAA,EAAA,CA5BA;AA6BA,MAAA,QAAA,EAAA,CA7BA;AA8BA,MAAA,QAAA,EAAA,EA9BA;AA+BA,MAAA,IAAA,EAAA;AA/BA,KAAA;AAiCA,GAnCA;AAoCA,EAAA,QAAA,EAAA;AACA,IAAA,SADA,uBACA;AACA,aAAA,KAAA,WAAA,KAAA,CAAA,CAAA,GAAA,gBAAA,GAAA,iBAAA;AACA;AAHA,GApCA;AAyCA,EAAA,KAAA,EAAA;AACA,