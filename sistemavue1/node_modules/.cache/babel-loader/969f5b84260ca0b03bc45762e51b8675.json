xpedicion\"></v-text-field>\n          </v-flex>\n          <v-flex xs12 sm12 md4>\n            <v-text-field v-model=\"timbrado.NumeroInicial\" label=\"Número Inicial\"></v-text-field>\n          </v-flex>\n          <v-flex xs12 sm12 md4>\n            <v-text-field v-model=\"timbrado.NumeroFinal\" label=\"Punto Final\"></v-text-field>\n          </v-flex>\n        </v-layout>\n        <v-layout wrap>\n          <v-flex xs12 sm12 md6>\n            <v-menu\n              ref=\"menu\"\n              v-model=\"menu\"\n              :close-on-content-click=\"false\"\n              :return-value.sync=\"timbrado.FechaInicioVigencia\"\n              transition=\"scale-transition\"\n              offset-y\n              min-width=\"290px\"\n            >\n              <template v-slot:activator=\"{ on, attrs }\">\n                <v-text-field\n                  v-model=\"timbrado.FechaInicioVigencia\"\n                  label=\"Fecha inicio vigencia\"\n                  prepend-icon=\"event\"\n                  readonly\n                  v-bind=\"attrs\"\n                  v-on=\"on\"\n                ></v-text-field>\n              </template>\n              <v-date-picker v-model=\"timbrado.FechaInicioVigencia\" no-title scrollable>\n                <v-spacer></v-spacer>\n                <v-btn text color=\"primary\" @click=\"menu = false\">Cancel</v-btn>\n                <v-btn\n                  text\n                  color=\"primary\"\n                  @click=\"$refs.menu.save(timbrado.FechaInicioVigencia)\"\n                >OK</v-btn>\n              </v-date-picker>\n            </v-menu>\n          </v-flex>\n          <v-flex xs12 sm12 md6>\n            <v-menu\n              ref=\"menu2\"\n              v-model=\"menu2\"\n              :close-on-content-click=\"false\"\n              :return-value.sync=\"timbrado.FechaFinVigencia\"\n              transition=\"scale-transition\"\n              offset-y\n              min-width=\"290px\"\n            >\n              <template v-slot:activator=\"{ on, attrs }\">\n                <v-text-field\n                  v-model=\"timbrado.FechaFinVigencia\"\n                  label=\"Fecha fin vigencia\"\n                  prepend-icon=\"event\"\n                  readonly\n                  v-bind=\"attrs\"\n                  v-on=\"on\"\n                ></v-text-field>\n              </template>\n              <v-date-picker v-model=\"timbrado.FechaFinVigencia\" no-title scrollable>\n                <v-spacer></v-spacer>\n                <v-btn text color=\"primary\" @click=\"menu2 = false\">Cancel</v-btn>\n                <v-btn text color=\"primary\" @click=\"$refs.menu2.save(timbrado.FechaFinVigencia)\">OK</v-btn>\n              </v-date-picker>\n            </v-menu>\n          </v-flex>\n        </v-layout>\n\n        <v-flex xs12 sm12 md12>\n          <!-- <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div> -->\n          <v-checkbox v-model=\"timbrado.Estado\" label=\"Estado\"></v-checkbox>\n        </v-flex>\n      </v-container>\n    </v-card-text>\n    <v-card-actions>\n      <v-spacer></v-spacer>\n      <v-btn class=\"mb-2\" dark color=\"red accent-3\">\n        Cancelar\n        <v-icon dark right>mdi-cancel</v-icon>\n      </v-btn>\n      <v-btn color=\"green darken-3\" class=\"mb-2\" dark @click=\"guardar()\">\n        Guardar\n        <v-icon dark right>mdi-checkbox-marked-circle</v-icon>\n      </v-btn>\n    </v-card-actions>\n  </v-card>\n</template>\n<script>\nimport { METHODS } from 'http';\nexport default {\n  data() {\n    return {\n      timbrado: this.createFreshTimbrado(),\n      menu: false,\n      menu2: false,\n      dialog: false,\n      token_configracion: [],\n    };\n  },\n  name: 'Formulario_timbrado',\n  methods:{\n    createFreshTimbrado() {\n      return {\n        NumeroTimbrado: \"\",\n        CodigoSucursal: \"\",\n        PuntoExpedicion: \"\",\n        CodigoTiposDocumento: \"\",\n        FechaInicioVigencia: new Date().toISOString().substr(0, 10),\n        FechaFinVigencia: new Date().toISOString().substr(0, 10),\n        NumeroInicial: \"\",\n        NumeroFinal: \"\",\n        Estado: \"\",\n        configuracion:[],\n      };\n    },\n    guardar() {\n      console.log(\"Enviando datos ----------------->\");\n      this.timbrado.configuracion = this.token_configracion;\n      this.$store.dispatch(\"insertTimbrado\", this.timbrado).then((result)=>{\n        console.log(\"Good job\");\n        this.timbrado = this.createFreshTimbrado();\n      }).catch((err)=>{\n        console.log(\"Bad! this is sad\")\n      });\n    },\n  }\n};\n</script>"],"sourceRoot":"src/components/referenciales-facturas"}]}