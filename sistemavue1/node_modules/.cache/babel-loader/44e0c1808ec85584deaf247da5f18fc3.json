NivelUsuario\n              console.log ( me.da.users);\n              this.$router.push({name: 'bienvenida',params:{\n                  rol:me.da.NivelUsuario,\n                  users:me.da.users\n                }});\n            })\n            .then(response =>{\n                \n                // this.$router.push({name: 'bienvenida',params:{\n                //   rol:rol\n                // }})\n                ;\n            })\n            .catch(error =>{\n                //console.log(eror);\n             return respuesta.data;\n             // console.log (respuesta.data.tokenData);\n            }).then(data=>{\n  \n              this.$store.dispatch(\"guardarToken\",data.token);\n              this.$router.push({name:'Bienvenida'})\n            })\n            .catch(error =>{\n                console.log(eror);\n                this.errorM=null;\n                if (error.response.status==404){\n                    this.errorM='No existe el usuario o las credenciales son   incorrectas.';\n                } else{\n                    this.errorM='Ocurrió un error con el servidor.';\n                } \n            });\n    },\n  }\n}\n</script>\n\n<style scoped lang=\"css\">\n  #login {\n    height: 50%;\n    width: 100%;\n    position: absolute;\n    top: 0;\n    left: 0;\n    content: \"\";\n    z-index: 0;\n  }\n</style>"],"sourceRoot":"src/components/acceso"}]}