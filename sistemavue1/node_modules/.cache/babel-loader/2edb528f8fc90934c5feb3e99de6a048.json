ders: [{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"CodigoCategoria\",\n        sortable: true\n      }, {\n        text: \"Descripción\",\n        value: \"Descripcion\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      CodigoCategoria: \"\",\n      Descripcion: \"\",\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var me = this;\n      axios.get(\"categorias/\").then(function (response) {\n        me.categorias = response.data;\n        console.log(me.categorias.data);\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Descripcion.length < 1) {\n        this.validaMensaje.push(\"El nombre de la categoria debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.CodigoCategoria, this.Descripcion);\n        axios.put(\"categorias/\", {\n          CodigoCategoria: this.CodigoCategoria,\n          Descripcion: this.Descripcion\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        axios.post(\"categorias/\", {\n          Descripcion: this.Descripcion\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoCategoria = item.CodigoCategoria;\n      this.Descripcion = item.Descripcion;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.Descripcion;\n      this.adId = item.CodigoCategoria;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    activar: function activar() {\n      var me = this;\n      axios.put(\"categoria/\", {\n        CodigoCategoria: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    desactivar: function desactivar() {\n      var me = this;\n      axios.put(\"categoria/deactivate\", {\n        _id: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    close: function close() {\