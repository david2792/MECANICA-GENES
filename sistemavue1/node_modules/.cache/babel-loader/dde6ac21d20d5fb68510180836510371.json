 \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"codigo\",\n        sortable: true\n      }, {\n        text: \"Descripción\",\n        value: \"nombre\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      codigo: \"\",\n      nombre: \"\",\n      validaMensaje: [],\n      valida: '',\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"estadotransmiciones/\", configuracion).then(function (response) {\n        me.categorias = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.nombre = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.nombre.length < 1) {\n        this.validaMensaje.push(\"El nombre de la recepcion debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para 