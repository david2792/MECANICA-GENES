A;AACA,KAvGA;AAyGA,IAAA,uBAzGA,qCAyGA;AACA,WAAA,OAAA,GAAA,CAAA;AACA,KA3GA;AA6GA,IAAA,KA7GA,mBA6GA;AACA,WAAA,MAAA,GAAA,KAAA;AACA;AA/GA;AAxCA,CAAA","sourcesContent":["<template>\n  <v-layout align-start>\n    <v-flex>\n      <v-toolbar flat color=\"white\">\n        <v-toolbar-title>Ciudad</v-toolbar-title>\n        <v-divider class=\"mx-2\" inset vertical></v-divider>\n        <v-spacer></v-spacer>\n        <v-text-field\n          class=\"text-xs-center\"\n          v-model=\"search\"\n          append-icon=\"search\"\n          label=\"Búsqueda\"\n          single-line\n          hide-details\n        ></v-text-field>\n        <v-spacer></v-spacer>\n        <v-dialog v-model=\"dialog\" max-width=\"500px\">\n          <template v-slot:activator=\"{ on }\">\n            <v-btn  color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\n          </template>\n          <v-card>\n            <v-card-title>\n              <span class=\"headline\">{{ formTitle }}</span>\n            </v-card-title>\n            <v-card-text>\n              <v-container grid-list-md>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md12>\n                    <v-text-field v-model=\"Nombre\" label=\"Nombre\"></v-text-field>\n                  </v-flex>\n                </v-layout>\n                 <v-layout wrap>\n                  <v-flex xs12 sm12 md12>\n                    <v-autocomplete\n                      :items=\"Departamentos\"\n                      v-model=\"Departamento\"\n                      item-value=\"Departamento\"\n                      label=\"Departamentos\"\n                    ></v-autocomplete>\n                  </v-flex>\n                </v-layout>\n                <v-flex xs12 sm12 md12 v-show=\"valida\">\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\n                </v-flex>\n              </v-container>\n            </v-card-text>\n            <v-card-actions>\n              <v-spacer></v-spacer>\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\n            </v-card-actions>\n          </v-card>\n        </v-dialog>\n                <!-- dialogo confirmacion -->\n        <template>\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\n            <v-card dark color=\"blue lighten-3\">\n              <v-card-title class=\"headline\">\n                <v-img\n                  class=\"white--text align-end\"\n                  :src=\"require('../../assets/ok.png')\"\n                  contain\n                  height=\"100\"\n                ></v-img>\n              </v-card-title>\n              <center>\n                <v-card-text>\n                  <h3 class=\"white--text align-end\">Se agrego la Ciudad</h3>\n                </v-card-text>\n              </center>\n              <v-card-actions>\n                <v-spacer></v-spacer>\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\n              </v-card-actions>\n            </v-card>\n          </v-dialog>\n        </template>\n        <!-- fin dialogo -->\n      </v-toolbar>\n      <v-data-table :headers=\"headers\" :items=\"ciudades\" :search=\"search\" class=\"elevation-1\">\n        <template v-slot:items=\"props\">\n          <td class=\"justify-center layout px-0\">\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon>\n            </v-btn>\n          </td>\n          <td>{{ props.item.CodigoCiudad }}</td>\n          <td>{{ props.item.Ciudad }}</td>\n          <td>{{ props.item.Departamento }}</td>\n          <td></td>\n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n<script>\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      dialog: false,\n      search: \"\",\n      Departamentos: [],\n      ciudades:[],\n      headers: [\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\n        { text: \"Codigo\", value: \"CodigoCiudad\", sortable: true },\n        { text: \"Nombre\", value: \"Nombre\", sortable: false },\n        { text: \"Departamento\", value: \"Departamento\", sortable: false }\n      ],\n      dialogoConfirmacion: false,\n      editedIndex: -1,\n      CodigoCiudad: \"\",\n      Nombre: \"\",\n      Departamento:'',\n      validaMensaje: [],\n      valida: 0,\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n    this.selectDepartamento();\n  },\n  methods: {\n    listar() {\n      let me = this;\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      axios\n        .get(\"ciudades/\",configuracion)\n        .then(function(response) {\n          me.ciudades = response.data;\n          console.log(ciudades)\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n      selectDepartamento() {\n      let me = this;\n      let depaArray = [];\n      let header = { \"auth-token\": this.$store.state.token };\n      let configuracion = { headers: header };\n      axios\n        .get(\"departamentos/\", configuracion)\n        .then(function(response) {\n          depaArray = response.data;\n          // console.log(categoriaArray)\n          depaArray.map(function(x) {\n            me.Departamentos.push({\n              text: x.Nombre,\n              value: x.CodigoDepartamento\n            });\n          });\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.Nombre = \"\";\n      this.Departamento='';\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.Nombre.length < 1) {\n        this.validaMensaje.push(\n          \"El nombre de la Ciudad debe tener entre 1-50 caracteres.\"\n        );\n      }\n       if (this.Departamento.length < 1) {\n        this.validaMensaje.push(\n          \"El nombre del Departamento debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n    guardar() {\n      let header = { \"auth-token\": this.$store.state.token };\n      let configuracion = { headers: header };\n      let me = this;\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        axios\n          .put(\"ciudades/\", {\n            CodigoCiudad: this.CodigoCiudad,\n            Nombre: this.Nombre,\n            Departamento:this.Departamento\n          },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        axios\n          .post(\"ciudades/\", { Nombre: this.Nombre,Departamento:this.Departamento},configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.CodigoCiudad = item.CodigoCiudad;\n      this.Nombre = item.Ciudad;\n      this.Departamento = item.Departamento;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n\n    activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n\n    close() {\n      this.dialog = false;\n    }\n  }\n};\n</script>\n"],"sourceRoot":"src/components/referenciales-localidades"}]}