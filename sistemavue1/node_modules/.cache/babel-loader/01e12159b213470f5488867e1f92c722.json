, {\n        text: \"Nombre\",\n        value: \"Nombre\",\n        sortable: false\n      }, {\n        text: \"Departamento\",\n        value: \"Departamento\",\n        sortable: false\n      }],\n      dialogoConfirmacion: false,\n      editedIndex: -1,\n      CodigoCiudad: \"\",\n      Nombre: \"\",\n      Departamento: '',\n      validaMensaje: [],\n      valida: 0,\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n    this.selectDepartamento();\n  },\n  methods: {\n    listar: function listar() {\n      var me = this;\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"ciudades/\", configuracion).then(function (response) {\n        me.ciudades = response.data;\n        console.log(ciudades);\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    selectDepartamento: function selectDepartamento() {\n      var me = this;\n      var depaArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"departamentos/\", configuracion).then(function (response) {\n        depaArray = response.data; // console.log(categoriaArray)\n\n        depaArray.map(function (x) {\n          me.Departamentos.push({\n            text: x.Nombre,\n            value: x.CodigoDepartamento\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Nombre = \"\";\n      this.Departamento = '';\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Nombre.length < 1) {\n        this.validaMensaje.push(\"El nombre de la Ciudad debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Departamento.length < 1) {\n        this.validaMensaje.push(\"El nombre del Departamento debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        axios.put(\"ciudades/\", {\n          CodigoCiudad: this.CodigoCiudad,\n          Nombre: this.Nombre,\n          Departamento: this.Departamento\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        axios.post(\"ciudades/\", {\n          Nombre: this.Nombre,\n          Departamento: this.Departamento\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoCiudad = item.CodigoCiudad;\n      this.Nombre = item.Ciudad;\n      this.Departamento = item.Departamento;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    close: functi