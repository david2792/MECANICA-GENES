AA,EAAA;AACA,aAAA,QAAA,GAAA,CAAA;AACA,OAFA,MAEA,IAAA,MAAA,IAAA,CAAA,EAAA;AACA,aAAA,QAAA,GAAA,CAAA;AACA,OAFA,MAEA;AACA,aAAA,OAAA,GAAA,CAAA;AACA;AACA,KApIA;AAqIA,IAAA,uBArIA,qCAqIA;AACA,WAAA,OAAA,GAAA,CAAA;AACA,KAvIA;AAyIA,IAAA,KAzIA,mBAyIA;AACA,WAAA,MAAA,GAAA,KAAA;AACA,WAAA,OAAA;AACA;AA5IA;AA/CA,CAAA","sourcesContent":["<template>\n  <v-layout align-start>\n    <v-flex>\n      <v-toolbar flat color=\"white\">\n        <v-toolbar-title>Mecanicos</v-toolbar-title>\n        <v-divider class=\"mx-2\" inset vertical></v-divider>\n        <v-spacer></v-spacer>\n        <v-text-field\n          class=\"text-xs-center\"\n          v-model=\"search\"\n          append-icon=\"search\"\n          label=\"Búsqueda\"\n          single-line\n          hide-details\n        ></v-text-field>\n        <v-spacer></v-spacer>\n        <v-dialog v-model=\"dialog\" max-width=\"500px\">\n          <template v-slot:activator=\"{ on }\">\n            <v-btn color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\n          </template>\n          <v-card>\n            <v-card-title>\n              <span class=\"headline\">{{ formTitle }}</span>\n            </v-card-title>\n            <v-card-text>\n              <v-container grid-list-md>\n                <v-layout wrap>\n                  <v-flex xs12 sm12 md12>\n                    <v-text-field v-model=\"Nombre\" label=\"Nombre\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm6 md6>\n                    <v-text-field v-model=\"Apellido\" label=\"Apellido\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm6 md6>\n                    <v-text-field v-model=\"Direccion\" label=\"Dirección\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm6 md6>\n                    <v-text-field v-model=\"Telefono\" label=\"Teléfono\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm6 md6>\n                    <v-text-field v-model=\"Email\" label=\"Email\"></v-text-field>\n                  </v-flex>\n                  <v-flex xs12 sm12 md12 v-show=\"valida\">\n                    <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\n                  </v-flex>\n                </v-layout>\n              </v-container>\n            </v-card-text>\n            <v-card-actions>\n              <v-spacer></v-spacer>\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\n            </v-card-actions>\n          </v-card>\n        </v-dialog>\n                        <!-- dialogo confirmacion -->\n        <template>\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\n            <v-card dark color=\"blue lighten-3\">\n              <v-card-title class=\"headline\">\n                <v-img\n                  class=\"white--text align-end\"\n                  :src=\"require('../../assets/ok.png')\"\n                  contain\n                  height=\"100\"\n                ></v-img>\n              </v-card-title>\n              <center>\n                <v-card-text>\n                  <h3 class=\"white--text align-end\">REGISTRO AGREGADO</h3>\n                </v-card-text>\n              </center>\n              <v-card-actions>\n                <v-spacer></v-spacer>\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\n              </v-card-actions>\n            </v-card>\n          </v-dialog>\n        </template>\n        <!-- fin dialogo -->\n      </v-toolbar>\n      <v-data-table :headers=\"headers\" :items=\"personas\" :search=\"search\" class=\"elevation-1\">\n        <template v-slot:items=\"props\">\n          <td class=\"justify-center layout px-0\">\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon>\n            </v-btn>\n          </td>\n          <td>{{ props.item.CodigoUsuario }}</td>\n          <td>{{ props.item.Nombre }}</td>\n          <td>{{ props.item.Apellido }}</td>\n          <td>{{ props.item.Direccion }}</td>\n          <td>{{ props.item.Telefono }}</td>\n          <td>{{ props.item.Email }}</td>\n         \n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n<script>\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      dialog: false,\n      search: \"\",\n      aux:[],\n      personas: [],\n      headers: [\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\n        { text: \"Codigo\", value: \"CodigoUsuario\", sortable: true },\n        { text: \"Nombre\", value: \"Nombre\", sortable: true },\n        { text: \"Apellido\", value: \"Apellido\", sortable: true },\n        { text: \"Direccion\", value: \"Direccion\", sortable: false },\n        { text: \"Telefono\", value: \"Telefono\", sortable: false },\n        { text: \"Email\", value: \"Email\", sortable: false },\n      \n      ],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      Nombre: \"\",\n      CodigoUsuario:'',\n      Apellido: \"\",\n      Direccion: \"\",\n      Telefono: \"\",\n      Email: \"\",\n      Ciudades:[],\n      valida: 0,\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n  },\n  methods: {\n    listar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      axios\n        .get(\"mecanico/listar\",configuracion)\n        .then(function(response) {\n          me.personas = response.data;\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.Nombre = \"\";\n      this.Apellido = \"\";\n      this.Direccion = \"\";\n      this.Telefono = \"\";\n      this.Email = \"\";\n      this.valida = 0;\n      this.validaMensaje = [];\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.Nombre.length < 1 ) {\n        this.validaMensaje.push(\n          \"El nombre de la persona debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.Apellido.length < 1) {\n        this.validaMensaje.push(\n          \"El cedula no puede estar vacia.\"\n        );\n      }\n      if (this.Direccion.length < 1) {\n        this.validaMensaje.push(\n          \"La dirección no puede estar vacia.\"\n        );\n      }\n      if (this.Telefono.length  < 1) {\n        this.validaMensaje.push(\n          \"El teléfono no  puede estar vacio.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n\n    guardar() {\n      let me = this;\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.Ciudad)\n        axios\n          .put(\n            \"mecanico/actualizar\",\n            {\n              CodigoUsuario:this.CodigoUsuario,\n              Nombre: this.Nombre,\n              Apellido: this.Apellido,\n              Direccion: this.Direccion,\n              Telefono: this.Telefono,\n              Email: this.Email\n            },\n            configuracion\n          )\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        //Código para guardar\n        axios\n          .post(\n            \"mecanico/guardar\",\n            {\n            CodigoUsuario: this.CodigoUsuario,\n              Nombre: this.Nombre,\n              Apellido: this.Apellido,\n              Direccion: this.Direccion,\n              Telefono: this.Telefono,\n              Email: this.Email\n            },\n            configuracion\n          )\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.CodigoUsuario = item.CodigoUsuario;\n      this.Nombre = item.Nombre;\n      this.Apellido = item.Apellido;\n      this.Direccion = item.Direccion;\n      this.Telefono = item.Telefono;\n      this.Email = item.Email;  \n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.nombre;\n      this.adId = item._id;\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n \n    close() {\n      this.dialog = false;\n      this.limpiar();\n    }\n  }\n};\n</script>"],"sourceRoot":"src/components/referenciales-personas"}]}