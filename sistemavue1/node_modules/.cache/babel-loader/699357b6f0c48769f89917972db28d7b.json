/\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\nimport axios from \"axios\";\nexport default {\n  data: function data() {\n    return {\n      dialog: false,\n      search: \"\",\n      aux: [],\n      personas: [],\n      headers: [{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"CodigoUsuario\",\n        sortable: true\n      }, {\n        text: \"Nombre\",\n        value: \"Nombre\",\n        sortable: true\n      }, {\n        text: \"Apellido\",\n        value: \"Apellido\",\n        sortable: true\n      }, {\n        text: \"Direccion\",\n        value: \"Direccion\",\n        sortable: false\n      }, {\n        text: \"Telefono\",\n        value: \"Telefono\",\n        sortable: false\n      }, {\n        text: \"Email\",\n        value: \"Email\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      Nombre: \"\",\n      CodigoUsuario: '',\n      Apellido: \"\",\n      Direccion: \"\",\n      Telefono: \"\",\n      Email: \"\",\n      Ciudades: [],\n      valida: 0,\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"mecanico/listar\", configuracion).then(function (response) {\n        me.personas = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Nombre = \"\";\n      this.Apellido = \"\";\n      this.Direccion = \"\";\n      this.Telefono = \"\";\n      this.Email = \"\";\n      this.valida = 0;\n      this.validaMensaje = [];\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Nombre.length < 1) {\n        this.validaMensaje.push(\"El nombre de la persona debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Apellido.length < 1) {\n        this.validaMensaje.push(\"El cedula no puede estar vacia.\");\n      }\n\n      if (this.Direccion.length < 1) {\n        this.validaMensaje.push(\"La dirección no puede estar vacia.\");\n      }\n\n      if (this.Telefono.length < 1) {\n        this.validaMensaje.push(\"El teléfono no  puede estar vacio.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var me = this;\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.Ciudad);\n        axios.put(\"mecanico/actualizar\", {\n          CodigoUsuario: this.CodigoUsuario,\n          Nombre: this.Nombre,\n          Apellido: this.Apellido,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        //Código para guardar\n        axios.post(\"mecanico/guardar\", {\n          CodigoUsuario: this.CodigoUsuario,\n          Nombre: this.Nombre,\n          Apellido: this.Apellido,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoUsuario = item.CodigoUsuario;\n      this.Nombre = item.Nombre;\n      this.Apellido = item.Apellido;\n      this.Direccion = item.Direccion;\n      this.Telefono = item.Telefono;\n      this.Email = item.Email;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.nombre;\n      this.adId = item._id;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    close: function close() {\n      this.dialog = false;\n      this.limpiar();\n    }\n  }\n};",{"version":3,"sources":["Mecanico.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyGA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,GAAA,EAAA,EAHA;AAIA,MAAA,QAAA,EAAA,EAJA;AAKA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,eAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,