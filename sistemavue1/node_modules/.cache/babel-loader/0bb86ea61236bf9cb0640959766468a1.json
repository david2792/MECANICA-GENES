x-2\"\n                inset\n                vertical\n                ></v-divider>\n                <v-spacer></v-spacer>\n                <v-text-field class=\"text-xs-center\" v-model=\"search\" append-icon=\"search\" \n                label=\"Búsqueda\" single-line hide-details></v-text-field>\n                <v-spacer></v-spacer>\n                <v-dialog v-model=\"dialog\" max-width=\"500px\">\n                    <template v-slot:activator=\"{ on }\">\n                        <v-btn  color=\"amber darken-4\"  dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\n                    </template>\n                    <v-card>\n                        <v-card-title>\n                        <span class=\"headline\">{{ formTitle }}</span>\n                        </v-card-title>            \n                        <v-card-text>\n                        <v-container grid-list-md>\n                            <v-layout wrap>\n                                <v-flex xs12 sm12 md12>\n                                    <v-text-field v-model=\"Descripcion\" label=\"Descripción\"></v-text-field>\n                                </v-flex>\n                            </v-layout>\n                            <!--  -->\n                             <v-layout wrap>\n                                <v-flex xs12 sm12 md12>\n                                    <v-text-field v-model=\"Porcentaje\" label=\"Porcentaje\"></v-text-field>\n                                </v-flex>\n                            </v-layout>\n                            <!--  -->\n                            <v-layout wrap>\n                                <v-flex xs12 sm12 md12>\n                                    <v-text-field v-model=\"DividirPor\" label=\"Dividir\"></v-text-field>\n                                </v-flex>\n                            </v-layout>\n                             <v-flex xs12 sm12 md12 v-show=\"valida\">\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\n                </v-flex>\n                        </v-container>\n                        </v-card-text>            \n                        <v-card-actions>\n                        <v-spacer></v-spacer>\n                        <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\n                        <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\n                        </v-card-actions>\n                    </v-card>\n                </v-dialog>\n                    <!-- inicio -->\n     <template>\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\n            <v-card dark color=\"blue lighten-3\">\n              <v-card-title class=\"headline\">\n                <v-img\n                  class=\"white--text align-end\"\n                  :src=\"require('../../assets/ok.png')\"\n                  contain\n                  height=\"100\"\n                ></v-img>\n              </v-card-title>\n              <center>\n                <v-card-text>\n                  <h3 class=\"white--text align-end\">Se agrego El Impuesto</h3>\n                </v-card-text>\n              </center>\n              <v-card-actions>\n                <v-spacer></v-spacer>\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\n              </v-card-actions>\n            </v-card>\n          </v-dialog>\n        </template>\n                <!-- fin transaccion -->\n            </v-toolbar>\n            <v-data-table\n                :headers=\"headers\"\n                :items=\"impuestos\"\n                :search=\"search\"\n                class=\"elevation-1\"\n            >\n                <template v-slot:items=\"props\">\n                <td class=\"justify-center layout px-0\">\n                    <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon></v-btn>\n                </td>\n                <td>{{ props.item.CodigImpuesto }}</td>\n                <td>{{ props.item.Descripcion }}</td>\n                <td>{{ props.item.Porcentaje }}</td>\n                <td>{{ props.item.DividirPor }}</td>\n                <td>\n                </td>                \n                </template>\n                <template v-slot:no-data>\n                <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n                </template>\n            </v-data-table>\n        </v-flex>\n    </v-layout>\n</template>\n<script>\n    import axios from 'axios'\n    export default {\n        data(){\n            return{\n                dialog: false,\n                search:'',\n                impuestos:[],\n                headers: [\n                    { text: 'Opciones', value: 'opciones', sortable: false },\n                    { text: 'Codigo', value: 'CodigImpuesto', sortable: true },\n                    { text: 'Descripción', value: 'Descripcion', sortable: false },\n                    { text: 'Porcentaje', value: 'Porcentaje', sortable: false },\n                      { text: 'Dividir', value: 'DividirPor', sortable: false },\n\n                ],\n                editedIndex: -1,\n                dialogoConfirmacion:false,\n                CodigImpuesto:'',\n                Descripcion:'',\n                Porcentaje:'',\n                DividirPor:'',\n                validaMensaje:[],\n                adModal:0,\n                adAccion:0,\n                adNombre:'',\n                adId:''\n            }\n        },\n        computed: {\n            formTitle () {\n            return this.editedIndex === -1 ? 'Nuevo registro' : 'Editar registro'\n            }\n        },\n        watch: {\n            dialog (val) {\n            val || this.close()\n            }\n        },\n        created () {\n            this.listar()\n        },\n        methods: {\n            listar(){\n                let me=this;\n                axios.get('impuestos/').then(function (response){\n                    me.impuestos=response.data;\n                }).catch(function(error){\n                    console.log(error);\n                });\n\n            },\n            limpiar(){\n                this.Descripcion='';\n                this.Porcentaje='';\n                this.DividirPor='';\n                this.editedIndex=-1;\n            },\n            validar(){\n                this.valida=0;\n                this.validaMensaje=[];\n                if(this.Descripcion.length<1){\n                    this.validaMensaje.push('El nombre del Impuesto debe tener entre 1-50 caracteres.');\n                }\n                if(this.Porcentaje.length<1){\n                    this.validaMensaje.push('Ingrese el porcentaje.');\n                }\n                 if(this.DividirPor.length<1){\n                    this.validaMensaje.push('Ingrese el divisor');\n                }\n                if (this.validaMensaje.length){\n                    this.valida=1;\n                }\n                return this.valida;\n            },\n            guardar(){\n                let me=this;\n                if (this.validar()){\n                    return;\n                }\n                if (this.editedIndex >-1){\n                    //Código para editar\n                  console.log(this.CodigImpuesto,this.Descripcion,this.Porcentaje)\n                    axios.put('impuestos/',{'CodigImpuesto':this.CodigImpuesto,'Descripcion':this.Descripcion,'Porcentaje':this.Porcentaje,'DividirPor':this.DividirPor})\n                    .then(function(response){\n                        me.limpiar();\n                        me.close();\n                        me.listar();\n                        me.dialogoConfirmacion=true;\n                    })\n                    .catch(function(error){\n                        console.log(error);\n                    }); \n                }else{\n                    console.log(this.CodigImpuesto,this.Descripcion,this.Porcentaje)\n                    axios.post('impuestos/',{'Descripcion':this.Descripcion,'Porcentaje':this.Porcentaje,'DividirPor':this.DividirPor})\n                    .then(function(response){\n                        me.limpiar();\n                        me.close();\n                        me.listar();\n                        me.dialogoConfirmacion=true;\n                    })\n                    .catch(function(error){\n                        console.log(error);\n                    });\n                }\n            },\n            editItem (item) {\n                this.CodigImpuesto=item.CodigImpuesto;\n                this.Descripcion=item.Descripcion;\n                this.Porcentaje=item.Porcentaje;\n                this.DividirPor= item.DividirPor;\n                this.dialog = true;\n                this.editedIndex=1;\n            },\n            activarDesactivarMostrar(accion,item){\n                this.adModal=1;\n                this.adNombre=item.Descripcion;\n                this.adPorentaje = item.Porcentaje;\n                this.adDividir = item.DividirPor;\n                this.adId=item.CodigImpuesto;\n                if (accion==1){\n                    this.adAccion=1;\n                } else if(accion==2){\n                    this.adAccion=2;\n                } else{\n                    this.adModal=0;\n                }\n            },\n            activarDesactivarCerrar(){\n                this.adModal=0;\n            },\n            activar(){\n                let me=this;\n                axios.put('impuestos/',{'CodigImpuesto':this.adId})\n                    .then(function(response){\n                        me.adModal=0;\n                        me.adAccion=0;\n                        me.adNombre='';\n                        me.adSimbolo='';\n                        me.adId='';\n                        me.listar();\n                    })\n                    .catch(function(error){\n                        console.log(error);\n                    });\n            },\n            desactivar(){\n                let me=this;\n                axios.put('impuestos/deactivate',{'_id':this.adId})\n                    .then(function(response){\n                        me.adModal=0;\n                        me.adAccion=0;\n                        me.adNombre='';\n                        me.adId='';\n                        me.listar();\n                    })\n                    .catch(function(error){\n                        console.log(error);\n                    });\n            },\n            close () {\n                this.dialog = false;\n            }\n        }\n    }\n</script>\n"],"sourceRoot":"src/components/referenciales-productos"}]}