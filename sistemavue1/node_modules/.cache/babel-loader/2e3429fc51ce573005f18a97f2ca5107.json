[{\n        text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"CodigoUnidad\",\n        sortable: true\n      }, {\n        text: \"Descripción\",\n        value: \"Descripcion\",\n        sortable: false\n      }, {\n        text: \"Simbolo\",\n        value: \"Simbolo\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      CodigoUnidad: \"\",\n      Descripcion: \"\",\n      Simbolo: \"\",\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var me = this;\n      axios.get(\"unidades/\").then(function (response) {\n        me.medidas = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = \"\";\n      this.Simbolo = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Descripcion.length < 1) {\n        this.validaMensaje.push(\"La descripcion de la unidad debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Simbolo.length < 1) {\n        this.validaMensaje.push(\"El simbolo de la unidad no debe tener más de 1 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.CodigoUnidad, this.Descripcion, this.Simbolo);\n        axios.put(\"unidades/\", {\n          CodigoUnidad: this.CodigoUnidad,\n          Descripcion: this.Descripcion,\n          Simbolo: this.Simbolo\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        axios.post(\"unidades/\", {\n          Descripcion: this.Descripcion,\n          Simbolo: this.Simbolo\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoUnidad = item.CodigoUnidad;\n      this.Descripcion = item.Descripcion;\n      this.Simbolo = item.Simbolo;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.Descripcion;\n      this.adSimbolo = item.Simbolo;\n      this.adId = item.CodigoUnidad;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    activar: function activar() {\n      var me = this;\n      axios.put(\"unidades/\", {\n        CodigoUnidad: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adSimbolo = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    desactivar: function desactivar() {\n      var me = this;\n      axios.put(\"unidades/deactivate\", {\n        _id: this.adId\n      }).then(function (response) {\n        me.adModal = 0;\n        me.adAccion = 0;\n        me.adNombre = \"\";\n        me.adId = \"\";\n        me.listar();\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    close: function close() {\n      this.dialog = false;\n    }\n  }\n};",{"version":3,"sources":["Medida.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAiGA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,OAAA,EAAA,EAHA;AAIA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,cAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,EAAA,aAAA;AAAA,QAAA,KAAA,EAAA,aAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAHA,EAIA;AAAA,QAAA,IAAA,EAAA,SAAA;AAAA,QAAA,KAAA,EAAA,SAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAJA,CAJA;AAUA,MAAA,WAAA,EAAA,CAAA,CAVA;AAWA,MAAA,mBAAA,EAAA,KAXA;AAYA,MAAA,YAAA,EAAA,EAZA;AAaA,MAAA,WAAA,EAAA,EAbA;AAcA,MAAA,OAAA,EAAA,EAdA;AAeA,MAAA,aAAA,EAAA,EAfA;AAgBA,MAAA,OAAA,EAAA,CAhBA;AAiBA,MAAA,QAAA,EAAA,CAjBA;AAkBA,MAAA,QAAA,EAAA,EAlBA;AAmBA,MAAA,IAAA,EAAA;AAnBA,KAAA;AAqBA,GAvBA;AAwBA,EAAA,QAAA,EAAA;AACA,IAAA,SADA,uBACA;AACA,aAAA,KAAA,WAAA,KAAA,CAAA,CAAA,GAAA,gBAAA,GAAA,iBAAA;AACA;AAHA,GAxBA;AA6BA,EAAA,KAAA,EAAA;AACA,IAAA,MADA,kBACA,GADA,EACA;AACA,MAAA,GAAA,IAAA,KAAA,KAAA,EAAA;AACA;AAHA,GA7BA;AAkCA,EAAA,OAlCA,qBAkCA;AACA,SAAA,MAAA;AACA,GApCA;AAqCA,EAAA,OAAA,EAAA;AACA,IAAA,MADA,oBACA;AACA,UAAA,EAAA,GAAA,IAAA;AACA,MAAA,KAAA,CACA,GADA,CACA,WADA,EAEA,IAFA,CAEA,UAAA,QAAA,EAAA;AACA,QAAA,EAAA,CAAA,OAAA,GAAA,QAAA,CAAA,IAAA;AACA,OAJA,EAKA,KALA,CAKA,UAAA,KAAA,EAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,KAAA;AACA,OAPA;AAQA,KAXA;AAYA,IAAA,OAZA,qBAYA;AACA,WAAA,WAAA,GAAA,EAAA;AACA,WAAA,OAAA,GAAA,EAAA;AACA,W