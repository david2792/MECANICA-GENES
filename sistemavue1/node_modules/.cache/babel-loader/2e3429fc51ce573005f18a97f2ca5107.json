\"Descripcion\" label=\"Descripción\"></v-text-field>\r\n                  </v-flex>\r\n                </v-layout>\r\n                <!--  -->\r\n                <v-layout wrap>\r\n                  <v-flex xs12 sm12 md12>\r\n                    <v-text-field v-model=\"Simbolo\" label=\"Simbolo\"></v-text-field>\r\n                  </v-flex>\r\n                </v-layout>\r\n                <v-flex xs12 sm12 md12 v-show=\"valida\">\r\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\r\n                </v-flex>\r\n              </v-container>\r\n            </v-card-text>\r\n            <v-card-actions>\r\n              <v-spacer></v-spacer>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\r\n            </v-card-actions>\r\n          </v-card>\r\n          <!-- dialogo confirmacion -->\r\n        </v-dialog>\r\n         <!-- inicio -->\r\n     <template>\r\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\r\n            <v-card dark color=\"blue lighten-3\">\r\n              <v-card-title class=\"headline\">\r\n                <v-img\r\n                  class=\"white--text align-end\"\r\n                  :src=\"require('../../assets/ok.png')\"\r\n                  contain\r\n                  height=\"100\"\r\n                ></v-img>\r\n              </v-card-title>\r\n              <center>\r\n                <v-card-text>\r\n                  <h3 class=\"white--text align-end\">Se agrego la Unidad</h3>\r\n                </v-card-text>\r\n              </center>\r\n              <v-card-actions>\r\n                <v-spacer></v-spacer>\r\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\r\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\r\n              </v-card-actions>\r\n            </v-card>\r\n          </v-dialog>\r\n        </template>\r\n                <!-- fin transaccion -->\r\n      </v-toolbar>\r\n      <v-data-table :headers=\"headers\" :items=\"medidas\" :search=\"search\" class=\"elevation-1\">\r\n        <template v-slot:items=\"props\">\r\n          <td class=\"justify-center layout px-0\">\r\n             <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\r\n              <v-icon dark>mdi-pencil</v-icon>\r\n            </v-btn>\r\n          </td>\r\n          <td>{{ props.item.CodigoUnidad }}</td>\r\n          <td>{{ props.item.Descripcion }}</td>\r\n          <td>{{ props.item.Simbolo }}</td>\r\n          <td></td>\r\n        </template>\r\n        <template v-slot:no-data>\r\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-flex>\r\n  </v-layout>\r\n</template>\r\n<script>\r\nimport axios from \"axios\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      dialog: false,\r\n      search: \"\",\r\n      medidas: [],\r\n      headers: [\r\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\r\n        { text: \"Codigo\", value: \"CodigoUnidad\", sortable: true },\r\n        { text: \"Descripción\", value: \"Descripcion\", sortable: false },\r\n        { text: \"Simbolo\", value: \"Simbolo\", sortable: false }\r\n      ],\r\n      editedIndex: -1,\r\n      dialogoConfirmacion:false,\r\n      CodigoUnidad: \"\",\r\n      Descripcion: \"\",\r\n      Simbolo: \"\",\r\n      validaMensaje: [],\r\n      adModal: 0,\r\n      adAccion: 0,\r\n      adNombre: \"\",\r\n      adId: \"\"\r\n    };\r\n  },\r\n  computed: {\r\n    formTitle() {\r\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\r\n    }\r\n  },\r\n  watch: {\r\n    dialog(val) {\r\n      val || this.close();\r\n    }\r\n  },\r\n  created() {\r\n    this.listar();\r\n  },\r\n  methods: {\r\n    listar() {\r\n      let me = this;\r\n      axios\r\n        .get(\"unidades/\")\r\n        .then(function(response) {\r\n          me.medidas = response.data;\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    limpiar() {\r\n      this.Descripcion = \"\";\r\n      this.Simbolo = \"\";\r\n      this.editedIndex = -1;\r\n    },\r\n    validar() {\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      if (this.Descripcion.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"La descripcion de la unidad debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n      if (this.Simbolo.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El simbolo de la unidad no debe tener más de 1 caracteres.\"\r\n        );\r\n      }\r\n      if (this.validaMensaje.length) {\r\n        this.valida = 1;\r\n      }\r\n      return this.valida;\r\n    },\r\n    guardar() {\r\n      let me = this;\r\n      if (this.validar()) {\r\n        return;\r\n      }\r\n      if (this.editedIndex > -1) {\r\n        //Código para editar\r\n        console.log(this.CodigoUnidad, this.Descripcion, this.Simbolo);\r\n        axios\r\n          .put(\"unidades/\", {\r\n            CodigoUnidad: this.CodigoUnidad,\r\n            Descripcion: this.Descripcion,\r\n            Simbolo: this.Simbolo\r\n          })\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion=true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      } else {\r\n        axios\r\n          .post(\"unidades/\", {\r\n            Descripcion: this.Descripcion,\r\n            Simbolo: this.Simbolo\r\n          })\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n             me.dialogoConfirmacion=true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      }\r\n    },\r\n    editItem(item) {\r\n      this.CodigoUnidad = item.CodigoUnidad;\r\n      this.Descripcion = item.Descripcion;\r\n      this.Simbolo = item.Simbolo;\r\n      this.dialog = true;\r\n      this.editedIndex = 1;\r\n    },\r\n    activarDesactivarMostrar(accion, item) {\r\n      this.adModal = 1;\r\n      this.adNombre = item.Descripcion;\r\n      this.adSimbolo = item.Simbolo;\r\n      this.adId = item.CodigoUnidad;\r\n      if (accion == 1) {\r\n        this.adAccion = 1;\r\n      } else if (accion == 2) {\r\n        this.adAccion = 2;\r\n      } else {\r\n        this.adModal = 0;\r\n      }\r\n    },\r\n    activarDesactivarCerrar() {\r\n      this.adModal = 0;\r\n    },\r\n    activar() {\r\n      let me = this;\r\n      axios\r\n        .put(\"unidades/\", { CodigoUnidad: this.adId })\r\n        .then(function(response) {\r\n          me.adModal = 0;\r\n          me.adAccion = 0;\r\n          me.adNombre = \"\";\r\n          me.adSimbolo = \"\";\r\n          me.adId = \"\";\r\n          me.listar();\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    desactivar() {\r\n      let me = this;\r\n      axios\r\n        .put(\"unidades/deactivate\", { _id: this.adId })\r\n        .then(function(response) {\r\n          me.adModal = 0;\r\n          me.adAccion = 0;\r\n          me.adNombre = \"\";\r\n          me.adId = \"\";\r\n          me.listar();\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    close() {\r\n      this.dialog = false;\r\n    }\r\n  }\r\n};\r\n</script>\r\n"],"sourceRoot":"src/components/referenciales-productos"}]}