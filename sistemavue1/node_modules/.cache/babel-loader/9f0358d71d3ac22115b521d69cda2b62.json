  text: \"Opciones\",\n        value: \"opciones\",\n        sortable: false\n      }, {\n        text: \"Codigo\",\n        value: \"codigo\",\n        sortable: true\n      }, {\n        text: \"Descripción\",\n        value: \"nombre\",\n        sortable: false\n      }],\n      editedIndex: -1,\n      dialogoConfirmacion: false,\n      codigo: \"\",\n      nombre: \"\",\n      validaMensaje: [],\n      valida: '',\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"anios/\", configuracion).then(function (response) {\n        me.categorias = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.nombre = \"\";\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.nombre.length < 1) {\n        this.validaMensaje.push(\"El nombre de la recepcion debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.codigo, this.nombre);\n        axios.put(\"anios/\", {\n          codigo: this.codigo,\n          nombre: this.nombre\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        axios.post(\"anios/\", {\n          nombre: this.nombre\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.codigo = item.codigo;\n      this.nombre = item.nombre;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    close: function close() {\n      this.dialog = false;\n    }\n  }\n};",{"version":3,"sources":["Anio.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwFA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,UAAA,EAAA,EAHA;AAIA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,EAAA,aAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAHA,CAJA;AASA,MAAA,WAAA,EAAA,CAAA,CATA;AAUA,MAAA,mBAAA,EAAA,KAVA;AAWA,MAAA,MAAA,EAAA,EAXA;AAYA,MAAA,MAAA,EAAA,EAZA;AAaA,MAAA,aAAA,EAAA,EAbA;AAcA,MAAA,MAAA,EAAA,EAdA;AAeA,MAAA,OAAA,EAAA,CAfA;AAgBA,MAAA,QAAA,EAAA,CAhBA;AAiBA,MAAA,QAAA,EAAA,EAjBA;AAkBA,MAAA,IAAA,EAAA;AAlBA,KAAA;AAoBA,GAtBA;AAuBA,EAAA,QAAA,EAAA;AACA,IAAA,SADA,uBACA;AACA,aAAA,KAAA,WAAA,KAAA,CAAA,CAAA,GAAA,gBAAA,GAAA,iBAAA;AACA;AAHA,GAvBA;AA4BA,EAAA,KAAA,EAAA;AACA,IAAA,MADA,kBACA,GADA,EA