x xs12 sm12 md12 v-show=\"valida\">\n                  <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\n                </v-flex>\n              </v-container>\n            </v-card-text>\n            <v-card-actions>\n              <v-spacer></v-spacer>\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\n            </v-card-actions>\n          </v-card>\n        </v-dialog>\n                <!-- dialogo confirmacion -->\n        <template>\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\n            <v-card dark color=\"blue lighten-3\">\n              <v-card-title class=\"headline\">\n                <v-img\n                  class=\"white--text align-end\"\n                  :src=\"require('../../assets/ok.png')\"\n                  contain\n                  height=\"100\"\n                ></v-img>\n              </v-card-title>\n              <center>\n                <v-card-text>\n                  <h3 class=\"white--text align-end\">Se agrego el Pais</h3>\n                </v-card-text>\n              </center>\n              <v-card-actions>\n                <v-spacer></v-spacer>\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\n              </v-card-actions>\n            </v-card>\n          </v-dialog>\n        </template>\n        <!-- fin dialogo -->\n      </v-toolbar>\n      <v-data-table :headers=\"headers\" :items=\"paises\" :search=\"search\" class=\"elevation-1\">\n        <template v-slot:items=\"props\">\n          <td class=\"justify-center layout px-0\">\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon>\n            </v-btn>\n          </td>\n          <td>{{ props.item.CodigoPais }}</td>\n          <td>{{ props.item.Nombre }}</td>\n          <td></td>\n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n<script>\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      dialog: false,\n      search: \"\",\n      paises: [],\n      headers: [\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\n        { text: \"Codigo\", value: \"CodigoPais\", sortable: true },\n        { text: \"Nombre\", value: \"Nombre\", sortable: false }\n      ],\n      dialogoConfirmacion: false,\n      editedIndex: -1,\n      CodigoPais: \"\",\n      Nombre: \"\",\n      validaMensaje: [],\n      valida: 0,\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n  },\n  methods: {\n    listar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      axios\n        .get(\"paises/\",configuracion)\n        .then(function(response) {\n          me.paises = response.data;\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.Nombre = \"\";\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.Nombre.length < 1) {\n        this.validaMensaje.push(\n          \"El nombre del pais debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n    guardar() {\n      let header={\"auth-token\":this.$store.state.token};\n      let configuracion={headers:header};\n      let me = this;\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.CodigoPais, this.Nombre);\n        axios\n          .put(\"paises/\", {\n            CodigoPais: this.CodigoPais,\n            Nombre: this.Nombre\n          },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        axios\n          .post(\"paises/\", { Nombre: this.Nombre },configuracion)\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion = true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.CodigoPais = item.CodigoPais;\n      this.Nombre = item.Nombre;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n\n    activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    activar() {\n      let me = this;\n      axios\n        .put(\"marcas/\", { CodigoMarca: this.adId })\n        .then(function(response) {\n          me.adModal = 0;\n          me.adAccion = 0;\n          me.adNombre = \"\";\n          me.adId = \"\";\n          me.listar();\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    close() {\n      this.dialog = false;\n    }\n  }\n};\n</script>\n"],"sourceRoot":"src/components/referenciales-localidades"}]}
