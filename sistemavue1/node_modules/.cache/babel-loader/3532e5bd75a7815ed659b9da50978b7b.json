alidaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: '',\n      adId: ''\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      return this.editedIndex === -1 ? 'Nuevo registro' : 'Editar registro';\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n  },\n  methods: {\n    listar: function listar() {\n      var me = this;\n      axios.get('categorias/').then(function (response) {\n        me.categorias = response.data;\n        console.log(me.categorias.data);\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = '';\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.Descripcion.length < 1 || this.Descripcion.length > 50) {\n        this.validaMensaje.push('El nombre de la categoría debe tener entre 1-50 caracteres.');\n      }\n\n      if (this.Descripcion.length > 255) {\n        this.validaMensaje.push('La descripción de la categoría no debe tener más de 255 caracteres.');\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    guardar: function guardar() {\n      var me = this;\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.CodigoCategoria, this.Descripcion);\n        axios.put('categorias/', {\n          'CodigoCategoria': this.CodigoCategoria,\n          'Descripcion': this.Descripcion\n        }).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        axios.post('categorias/', {\n          'Descripcion': this.Descr