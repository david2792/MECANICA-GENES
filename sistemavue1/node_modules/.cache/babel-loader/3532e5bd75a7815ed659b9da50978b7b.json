     inset\r\n                vertical\r\n                ></v-divider>\r\n                <v-spacer></v-spacer>\r\n                <v-text-field class=\"text-xs-center\" v-model=\"search\" append-icon=\"search\" \r\n                label=\"Búsqueda\" single-line hide-details></v-text-field>\r\n                <v-spacer></v-spacer>\r\n                <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n                    <template v-slot:activator=\"{ on }\">\r\n                        <v-btn color=\"primary\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\r\n                    </template>\r\n                    <v-card>\r\n                        <v-card-title>\r\n                        <span class=\"headline\">{{ formTitle }}</span>\r\n                        </v-card-title>            \r\n                        <v-card-text>\r\n                        <v-container grid-list-md>\r\n                            <v-layout wrap>\r\n                                <v-flex xs12 sm12 md12>\r\n                                    <v-text-field v-model=\"Descripcion\" label=\"Descripción\"></v-text-field>\r\n                                </v-flex>\r\n                            </v-layout>\r\n                        </v-container>\r\n                        </v-card-text>            \r\n                        <v-card-actions>\r\n                        <v-spacer></v-spacer>\r\n                        <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\r\n                        <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\r\n                        </v-card-actions>\r\n                    </v-card>\r\n                </v-dialog>\r\n            </v-toolbar>\r\n            <v-data-table\r\n                :headers=\"headers\"\r\n                :items=\"categorias\"\r\n                :search=\"search\"\r\n                class=\"elevation-1\"\r\n            >\r\n                <template v-slot:items=\"props\">\r\n                <td class=\"justify-center layout px-0\">\r\n                    <v-icon\r\n                    small\r\n                    class=\"mr-2\"\r\n                    @click=\"editItem(props.item)\"\r\n                    >\r\n                    edit\r\n                    </v-icon>\r\n                </td>\r\n                <td>{{ props.item.CodigoCategoria }}</td>\r\n                <td>{{ props.item.Descripcion }}</td>\r\n                <td>\r\n                </td>                \r\n                </template>\r\n                <template v-slot:no-data>\r\n                <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\r\n                </template>\r\n            </v-data-table>\r\n        </v-flex>\r\n    </v-layout>\r\n</template>\r\n<script>\r\n    import axios from 'axios'\r\n    export default {\r\n        data(){\r\n            return{\r\n                dialog: false,\r\n                search:'',\r\n                categorias:[],\r\n                headers: [\r\n                    { text: 'Opciones', value: 'opciones', sortable: false },\r\n                    { text: 'Codigo', value: 'CodigoCategoria', sortable: true },\r\n                    { text: 'Descripción', value: 'Descripcion', sortable: false }\r\n                ],\r\n                editedIndex: -1,\r\n                CodigoCategoria:'',\r\n                Descripcion:'',\r\n                validaMensaje:[],\r\n                adModal:0,\r\n                adAccion:0,\r\n                adNombre:'',\r\n                adId:''\r\n            }\r\n        },\r\n        computed: {\r\n            formTitle () {\r\n            return this.editedIndex === -1 ? 'Nuevo registro' : 'Editar registro'\r\n            }\r\n        },\r\n        watch: {\r\n            dialog (val) {\r\n            val || this.close()\r\n            }\r\n        },\r\n        created () {\r\n            this.listar()\r\n        },\r\n        methods: {\r\n            listar(){\r\n                let me=this;\r\n                axios.get('categorias/').then(function (response){\r\n                    me.categorias=response.data;\r\n                    console.log(me.categorias.data)\r\n                }).catch(function(error){\r\n                    console.log(error);\r\n                });\r\n\r\n            },\r\n            limpiar(){\r\n                this.Descripcion='';\r\n                this.editedIndex=-1;\r\n            },\r\n            validar(){\r\n                this.valida=0;\r\n                this.validaMensaje=[];\r\n                if(this.Descripcion.length<1 || this.Descripcion.length>50){\r\n                    this.validaMensaje.push('El nombre de la categoría debe tener entre 1-50 caracteres.');\r\n                }\r\n                if(this.Descripcion.length>255){\r\n                    this.validaMensaje.push('La descripción de la categoría no debe tener más de 255 caracteres.');\r\n                }\r\n                if (this.validaMensaje.length){\r\n                    this.valida=1;\r\n                }\r\n                return this.valida;\r\n            },\r\n            guardar(){\r\n                let me=this;\r\n                if (this.validar()){\r\n                    return;\r\n                }\r\n                if (this.editedIndex >-1){\r\n                    //Código para editar\r\n                  console.log(this.CodigoCategoria,this.Descripcion)\r\n                    axios.put('categorias/',{'CodigoCategoria':this.CodigoCategoria,'Descripcion':this.Descripcion})\r\n                    .then(function(response){\r\n                        me.limpiar();\r\n                        me.close();\r\n                        me.listar();\r\n                    })\r\n                    .catch(function(error){\r\n                        console.log(error);\r\n                    }); \r\n                }else{\r\n                    axios.post('categorias/',{'Descripcion':this.Descripcion})\r\n                    .then(function(response){\r\n                        me.limpiar();\r\n                        me.close();\r\n                        me.listar();\r\n                    })\r\n                    .catch(function(error){\r\n                        console.log(error);\r\n                    });\r\n                }\r\n            },\r\n            editItem (item) {\r\n                this.CodigoCategoria=item.CodigoCategoria;\r\n                this.Descripcion=item.Descripcion;\r\n                this.dialog = true;\r\n                this.editedIndex=1;\r\n            },\r\n            activarDesactivarMostrar(accion,item){\r\n                this.adModal=1;\r\n                this.adNombre=item.Descripcion;\r\n                this.adId=item.CodigoCategoria;\r\n                if (accion==1){\r\n                    this.adAccion=1;\r\n                } else if(accion==2){\r\n                    this.adAccion=2;\r\n                } else{\r\n                    this.adModal=0;\r\n                }\r\n            },\r\n            activarDesactivarCerrar(){\r\n                this.adModal=0;\r\n            },\r\n            activar(){\r\n                let me=this;\r\n                axios.put('categoria/',{'CodigoCategoria':this.adId})\r\n                    .then(function(response){\r\n                        me.adModal=0;\r\n                        me.adAccion=0;\r\n                        me.adNombre='';\r\n                        me.adId='';\r\n                        me.listar();\r\n                    })\r\n                    .catch(function(error){\r\n                        console.log(error);\r\n                    });\r\n            },\r\n            desactivar(){\r\n                let me=this;\r\n                axios.put('categoria/deactivate',{'_id':this.adId})\r\n                    .then(function(response){\r\n                        me.adModal=0;\r\n                        me.adAccion=0;\r\n                        me.adNombre='';\r\n                        me.adId='';\r\n                        me.listar();\r\n                    })\r\n                    .catch(function(error){\r\n                        console.log(error);\r\n                    });\r\n            },\r\n            close () {\r\n                this.dialog = false;\r\n            }\r\n        }\r\n    }\r\n</script>\r\n"],"sourceRoot":"src/components"}]}