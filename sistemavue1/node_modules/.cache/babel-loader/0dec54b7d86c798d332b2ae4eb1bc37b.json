AAA;AACA,WAAA,MAAA,GAAA,IAAA,CAAA,MAAA;AACA,WAAA,SAAA,GAAA,IAAA,CAAA,SAAA;AACA,WAAA,QAAA,GAAA,IAAA,CAAA,QAAA;AACA,WAAA,KAAA,GAAA,IAAA,CAAA,KAAA;AACA,WAAA,MAAA,GAAA,IAAA,CAAA,MAAA;AACA,WAAA,MAAA,GAAA,IAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,KA1JA;AA2JA,IAAA,wBA3JA,oCA2JA,MA3JA,EA2JA,IA3JA,EA2JA;AACA,WAAA,OAAA,GAAA,CAAA;AACA,WAAA,QAAA,GAAA,IAAA,CAAA,MAAA;AACA,WAAA,IAAA,GAAA,IAAA,CAAA,GAAA;;AACA,UAAA,MAAA,IAAA,CAAA,EAAA;AACA,aAAA,QAAA,GAAA,CAAA;AACA,OAFA,MAEA,IAAA,MAAA,IAAA,CAAA,EAAA;AACA,aAAA,QAAA,GAAA,CAAA;AACA,OAFA,MAEA;AACA,aAAA,OAAA,GAAA,CAAA;AACA;AACA,KAtKA;AAuKA,IAAA,uBAvKA,qCAuKA;AACA,WAAA,OAAA,GAAA,CAAA;AACA,KAzKA;AA2KA,IAAA,KA3KA,mBA2KA;AACA,WAAA,MAAA,GAAA,KAAA;AACA,WAAA,OAAA;AACA;AA9KA;AAnDA,CAAA","sourcesContent":["<template>\r\n  <v-layout align-start>\r\n    <v-flex>\r\n      <v-toolbar flat color=\"white\">\r\n        <v-toolbar-title>Clientes</v-toolbar-title>\r\n        <v-divider class=\"mx-2\" inset vertical></v-divider>\r\n        <v-spacer></v-spacer>\r\n        <v-text-field\r\n          class=\"text-xs-center\"\r\n          v-model=\"search\"\r\n          append-icon=\"search\"\r\n          label=\"Búsqueda\"\r\n          single-line\r\n          hide-details\r\n        ></v-text-field>\r\n        <v-spacer></v-spacer>\r\n        <v-dialog v-model=\"dialog\" max-width=\"500px\">\r\n          <template v-slot:activator=\"{ on }\">\r\n            <v-btn color=\"amber darken-4\" dark class=\"mb-2\" v-on=\"on\">Nuevo</v-btn>\r\n          </template>\r\n          <v-card>\r\n            <v-card-title>\r\n              <span class=\"headline\">{{ formTitle }}</span>\r\n            </v-card-title>\r\n            <v-card-text>\r\n              <v-container grid-list-md>\r\n                <v-layout wrap>\r\n                  <v-flex xs12 sm12 md12>\r\n                    <v-text-field v-model=\"RazonSocial\" label=\"Razon Social\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-text-field v-model=\"Ruc\" label=\"RUC\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-text-field v-model=\"Cedula\" label=\"Número Documento\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-text-field v-model=\"Direccion\" label=\"Dirección\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-text-field v-model=\"Telefono\" label=\"Teléfono\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-text-field v-model=\"Email\" label=\"Email\"></v-text-field>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm6 md6>\r\n                    <v-autocomplete\r\n                      :items=\"Ciudades\"\r\n                      v-model=\"Ciudad\"\r\n                      item-value=\"Ciudad\"\r\n                      label=\"Ciudad\"\r\n                      value=\"CodigoCiudad\"\r\n                    ></v-autocomplete>\r\n                  </v-flex>\r\n                  <v-flex xs12 sm12 md12 v-show=\"valida\">\r\n                    <div class=\"red--text\" v-for=\"v in validaMensaje\" :key=\"v\" v-text=\"v\"></div>\r\n                  </v-flex>\r\n                </v-layout>\r\n              </v-container>\r\n            </v-card-text>\r\n            <v-card-actions>\r\n              <v-spacer></v-spacer>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"close\">Cancelar</v-btn>\r\n              <v-btn color=\"blue darken-1\" flat @click=\"guardar\">Guardar</v-btn>\r\n            </v-card-actions>\r\n          </v-card>\r\n        </v-dialog>\r\n                        <!-- dialogo confirmacion -->\r\n        <template>\r\n          <v-dialog v-model=\"dialogoConfirmacion\" persistent max-width=\"400\">\r\n            <v-card dark color=\"blue lighten-3\">\r\n              <v-card-title class=\"headline\">\r\n                <v-img\r\n                  class=\"white--text align-end\"\r\n                  :src=\"require('../../assets/ok.png')\"\r\n                  contain\r\n                  height=\"100\"\r\n                ></v-img>\r\n              </v-card-title>\r\n              <center>\r\n                <v-card-text>\r\n                  <h3 class=\"white--text align-end\">Cliente Agregado</h3>\r\n                </v-card-text>\r\n              </center>\r\n              <v-card-actions>\r\n                <v-spacer></v-spacer>\r\n                <v-btn color=\"orange\" text @click=\"dialogoConfirmacion = false\">Aceptar</v-btn>\r\n                <!-- <v-btn color=\"red \" text @click=\"listarprecio(item)\">Agregar Lista de Precio?</v-btn> -->\r\n              </v-card-actions>\r\n            </v-card>\r\n          </v-dialog>\r\n        </template>\r\n        <!-- fin dialogo -->\r\n      </v-toolbar>\r\n      <v-data-table :headers=\"headers\" :items=\"personas\" :search=\"search\" class=\"elevation-1\">\r\n        <template v-slot:items=\"props\">\r\n          <td class=\"justify-center layout px-0\">\r\n            <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\r\n              <v-icon dark>mdi-pencil</v-icon>\r\n            </v-btn>\r\n          </td>\r\n          <td>{{ props.item.CodigoCliente }}</td>\r\n          <td>{{ props.item.RazonSocial }}</td>\r\n          <td>{{ props.item.Cedula }}</td>\r\n          <td>{{ props.item.Ruc }}</td>\r\n          <td>{{ props.item.Direccion }}</td>\r\n          <td>{{ props.item.Telefono }}</td>\r\n          <td>{{ props.item.Email }}</td>\r\n          <td>{{ props.item.Ciudad }}</td>\r\n        </template>\r\n        <template v-slot:no-data>\r\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\r\n        </template>\r\n      </v-data-table>\r\n    </v-flex>\r\n  </v-layout>\r\n</template>\r\n<script>\r\nimport axios from \"axios\";\r\nexport default {\r\n  data() {\r\n    return {\r\n      dialog: false,\r\n      search: \"\",\r\n      aux:[],\r\n      personas: [],\r\n      headers: [\r\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\r\n        { text: \"Codigo\", value: \"CodigoCliente\", sortable: true },\r\n        { text: \"Razon Social\", value: \"RazonSocial\", sortable: true },\r\n        { text: \"Cedula\", value: \"Cedula\", sortable: true },\r\n        { text: \"RUC\", value: \"Ruc\", sortable: false },\r\n        { text: \"Dirección\", value: \"Direccion\", sortable: false },\r\n        { text: \"Teléfono\", value: \"Telefono\", sortable: false },\r\n        { text: \"Email\", value: \"Email\", sortable: false },\r\n        { text: \"Ciudad\", value: \"Ciudad\", sortable: false }\r\n      ],\r\n      editedIndex: -1,\r\n      dialogoConfirmacion: false,\r\n      RazonSocial: \"\",\r\n      CodigoCliente:'',\r\n      Cedula: \"\",\r\n      Ruc: \"\",\r\n      Direccion: \"\",\r\n      Telefono: \"\",\r\n      Ciudad: \"\",\r\n      Email: \"\",\r\n      Ciudades:[],\r\n      valida: 0,\r\n      validaMensaje: [],\r\n      adModal: 0,\r\n      adAccion: 0,\r\n      adNombre: \"\",\r\n      adId: \"\"\r\n    };\r\n  },\r\n  computed: {\r\n    formTitle() {\r\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\r\n    }\r\n  },\r\n  watch: {\r\n    dialog(val) {\r\n      val || this.close();\r\n    }\r\n  },\r\n  created() {\r\n    this.listar();\r\n    this.selectCiudad();\r\n  },\r\n  methods: {\r\n    listar() {\r\n      let header={\"auth-token\":this.$store.state.token};\r\n      let configuracion={headers:header};\r\n      let me = this;\r\n      axios\r\n        .get(\"clientes/\",configuracion)\r\n        .then(function(response) {\r\n          me.personas = response.data;\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    limpiar() {\r\n      this.Nombre = \"\";\r\n      this.RazonSocial = \"\";\r\n      this.Direccion = \"\";\r\n      this.Telefono = \"\";\r\n      this.Cedula='';\r\n      this.Ruc='';\r\n      this.Email = \"\";\r\n      this.Ciudad='';\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      this.editedIndex = -1;\r\n    },\r\n    validar() {\r\n      this.valida = 0;\r\n      this.validaMensaje = [];\r\n      if (this.RazonSocial.length < 1 ) {\r\n        this.validaMensaje.push(\r\n          \"El nombre de la persona debe tener entre 1-50 caracteres.\"\r\n        );\r\n      }\r\n      if (this.Cedula.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"El cedula no puede estar vacia.\"\r\n        );\r\n      }\r\n      if (this.Direccion.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"La dirección no puede estar vacia.\"\r\n        );\r\n      }\r\n      if (this.Telefono.length  < 1) {\r\n        this.validaMensaje.push(\r\n          \"El teléfono no  puede estar vacio.\"\r\n        );\r\n      }\r\n      if (this.Ciudad.length < 1) {\r\n        this.validaMensaje.push(\r\n          \"La Ciudad del usuario no puede estar vacio.\"\r\n        );\r\n      }\r\n      if (this.validaMensaje.length) {\r\n        this.valida = 1;\r\n      }\r\n      return this.valida;\r\n    },\r\n    selectCiudad() {\r\n      let me = this;\r\n      let ciudadArray = [];\r\n      let header={\"auth-token\":this.$store.state.token};\r\n      let configuracion={headers:header};\r\n      axios\r\n        .get(\"ciudades/\", configuracion)\r\n        .then(function(response) {\r\n          ciudadArray = response.data;\r\n          ciudadArray.map(function(x) {\r\n            me.Ciudades.push({\r\n              text: x.Ciudad,\r\n              value: x.CodigoCiudad\r\n            });\r\n          });\r\n        })\r\n        .catch(function(error) {\r\n          console.log(error);\r\n        });\r\n    },\r\n    guardar() {\r\n      let me = this;\r\n      let header={\"auth-token\":this.$store.state.token};\r\n      let configuracion={headers:header};\r\n      if (this.validar()) {\r\n        return;\r\n      }\r\n      if (this.editedIndex > -1) {\r\n        //Código para editar\r\n        console.log(this.Ciudad)\r\n        axios\r\n          .put(\r\n            \"clientes/\",\r\n            {\r\n              CodigoCliente:this.CodigoCliente,\r\n              CodigoCiudad: this.CodigoCiudad,\r\n              RazonSocial: this.RazonSocial,\r\n              Cedula: this.Cedula,\r\n              Ruc: this.Ruc,\r\n              Ciudad: this.Ciudad,\r\n              Direccion: this.Direccion,\r\n              Telefono: this.Telefono,\r\n              Email: this.Email\r\n            },\r\n            configuracion\r\n          )\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      } else {\r\n        //Código para guardar\r\n        axios\r\n          .post(\r\n            \"clientes/\",\r\n            {\r\n            CodigoCiudad: this.CodigoCiudad,\r\n              RazonSocial: this.RazonSocial,\r\n              Cedula: this.Cedula,\r\n              Ruc: this.Ruc,\r\n              Ciudad: this.Ciudad,\r\n              Direccion: this.Direccion,\r\n              Telefono: this.Telefono,\r\n              Email: this.Email\r\n            },\r\n            configuracion\r\n          )\r\n          .then(function(response) {\r\n            me.limpiar();\r\n            me.close();\r\n            me.listar();\r\n            me.dialogoConfirmacion = true;\r\n          })\r\n          .catch(function(error) {\r\n            console.log(error);\r\n          });\r\n      }\r\n    },\r\n    editItem(item) {\r\n      this.CodigoCliente = item.CodigoCliente;\r\n      this.RazonSocial = item.RazonSocial;\r\n      this.Ruc = item.Ruc;\r\n      this.Cedula = item.Cedula;\r\n      this.Direccion = item.Direccion;\r\n      this.Telefono = item.Telefono;\r\n      this.Email = item.Email;\r\n      this.Ciudad = item.Ciudad;\r\n      this.dialog = true;\r\n      this.editedIndex = 1;\r\n    },\r\n    activarDesactivarMostrar(accion, item) {\r\n      this.adModal = 1;\r\n      this.adNombre = item.nombre;\r\n      this.adId = item._id;\r\n      if (accion == 1) {\r\n        this.adAccion = 1;\r\n      } else if (accion == 2) {\r\n        this.adAccion = 2;\r\n      } else {\r\n        this.adModal = 0;\r\n      }\r\n    },\r\n    activarDesactivarCerrar() {\r\n      this.adModal = 0;\r\n    },\r\n \r\n    close() {\r\n      this.dialog = false;\r\n      this.limpiar();\r\n    }\r\n  }\r\n};\r\n</script>"],"sourceRoot":"src/components/referenciales-personas"}]}