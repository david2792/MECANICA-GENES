his.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"clientes/\", configuracion).then(function (response) {\n        me.personas = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Nombre = \"\";\n      this.RazonSocial = \"\";\n      this.Direccion = \"\";\n      this.Telefono = \"\";\n      this.Cedula = '';\n      this.Ruc = '';\n      this.Email = \"\";\n      this.Ciudad = '';\n      this.valida = 0;\n      this.validaMensaje = [];\n      this.editedIndex = -1;\n    },\n    validar: function validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n\n      if (this.RazonSocial.length < 1) {\n        this.validaMensaje.push(\"El nombre de la persona debe tener entre 1-50 caracteres.\");\n      }\n\n      if (this.Cedula.length < 1) {\n        this.validaMensaje.push(\"El cedula no puede estar vacia.\");\n      }\n\n      if (this.Direccion.length < 1) {\n        this.validaMensaje.push(\"La dirección no puede estar vacia.\");\n      }\n\n      if (this.Telefono.length < 1) {\n        this.validaMensaje.push(\"El teléfono no  puede estar vacio.\");\n      }\n\n      if (this.Ciudad.length < 1) {\n        this.validaMensaje.push(\"La Ciudad del usuario no puede estar vacio.\");\n      }\n\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n\n      return this.valida;\n    },\n    selectCiudad: function selectCiudad() {\n      var me = this;\n      var ciudadArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"ciudades/\", configuracion).then(function (response) {\n        ciudadArray = response.data;\n        ciudadArray.map(function (x) {\n          me.Ciudades.push({\n            text: x.Ciudad,\n            value: x.CodigoCiudad\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    guardar: function guardar() {\n      var me = this;\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n\n      if (this.validar()) {\n        return;\n      }\n\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.Ciudad);\n        axios.put(\"clientes/\", {\n          CodigoCliente: this.CodigoCliente,\n          CodigoCiudad: this.CodigoCiudad,\n          RazonSocial: this.RazonSocial,\n          Cedula: this.Cedula,\n          Ruc: this.Ruc,\n          Ciudad: this.Ciudad,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      } else {\n        //Código para guardar\n        axios.post(\"clientes/\", {\n          CodigoCiudad: this.CodigoCiudad,\n          RazonSocial: this.RazonSocial,\n          Cedula: this.Cedula,\n          Ruc: this.Ruc,\n          Ciudad: this.Ciudad,\n          Direccion: this.Direccion,\n          Telefono: this.Telefono,\n          Email: this.Email\n        }, configuracion).then(function (response) {\n          me.limpiar();\n          me.close();\n          me.listar();\n          me.dialogoConfirmacion = true;\n        }).catch(function (error) {\n          console.log(error);\n        });\n      }\n    },\n    editItem: function editItem(item) {\n      this.CodigoCliente = item.CodigoCliente;\n      this.RazonSocial = item.RazonSocial;\n      this.Ruc = item.Ruc;\n      this.Cedula = item.Cedula;\n      this.Direccion = item.Direccion;\n      this.Telefono = item.Telefono;\n      this.Email = item.Email;\n      this.Ciudad = item.Ciudad;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar: function activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.nombre;\n      this.adId = item._id;\n\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar: function activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    close: function close() {\n      this.dialog = false;\n      this.limpiar();\n    }\n  }\n};",{"version":3,"sources":["Cliente.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsHA,OAAA,KAAA,MAAA,OAAA;AACA,eAAA;AACA,EAAA,IADA,kBACA;AACA,WAAA;AACA,MAAA,MAAA,EAAA,KADA;AAEA,MAAA,MAAA,EAAA,EAFA;AAGA,MAAA,GAAA,EAAA,EAHA;AAIA,MAAA,QAAA,EAAA,EAJA;AAKA,MAAA,OAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,eAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAFA,EAGA;AAAA,QAAA,IAAA,EAAA,cAAA;AAAA,QAAA,KAAA,EAAA,aAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAHA,EAIA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAJA,EAKA;AAAA,QAAA,IAAA,EAAA,KAAA;AAAA,QAAA,KAAA,EAAA,KAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OALA,EAMA;AAAA,QAAA,IAAA,EAAA,WAAA;AAAA,QAAA,KAAA,EAAA,WAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OANA,EAOA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,UAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OAPA,EAQA;AAAA,QAAA,IAAA,EAAA,OAAA;AAAA,QAAA,KAAA,EAAA,OAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OARA,EASA;AAAA,QAAA,IAAA,EAAA,QAAA;AAAA,QAAA,KAAA,EAAA,QAAA;AAAA,QAAA,QAAA,EAAA;AAAA,OATA,CALA;AAgBA,MAAA,WAAA,EAAA,CAAA,CAhBA;AAiBA,MAAA,mBAAA,EAAA,KAjBA;AAkBA,MAAA,WAAA,EAAA,EAlBA;AAmBA,MAAA,aAAA,EAAA,EAnBA;AAoBA,MAAA,MAAA,EAAA,EApBA;AAqBA,MAAA,GAAA,EAAA,EArBA;AAsBA,MAAA,SAAA,EAAA,EAtBA;AAuBA,M