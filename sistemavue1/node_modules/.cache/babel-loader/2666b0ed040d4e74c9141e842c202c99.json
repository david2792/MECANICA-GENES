ayout px-0\">\n             <v-btn class=\"mx-2\" fab dark small color=\"amber darken-4\" @click=\"editItem(props.item)\">\n              <v-icon dark>mdi-pencil</v-icon>\n            </v-btn>\n          </td>\n          <td>{{ props.item.CodigoUnidad }}</td>\n          <td>{{ props.item.Descripcion }}</td>\n          <td>{{ props.item.Simbolo }}</td>\n          <td></td>\n        </template>\n        <template v-slot:no-data>\n          <v-btn color=\"primary\" @click=\"listar()\">Resetear</v-btn>\n        </template>\n      </v-data-table>\n    </v-flex>\n  </v-layout>\n</template>\n<script>\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      dialog: false,\n      search: \"\",\n      medidas: [],\n      headers: [\n        { text: \"Opciones\", value: \"opciones\", sortable: false },\n        { text: \"Codigo\", value: \"CodigoUnidad\", sortable: true },\n        { text: \"Descripción\", value: \"Descripcion\", sortable: false },\n        { text: \"Simbolo\", value: \"Simbolo\", sortable: false }\n      ],\n      editedIndex: -1,\n      dialogoConfirmacion:false,\n      CodigoUnidad: \"\",\n      Descripcion: \"\",\n      Simbolo: \"\",\n      validaMensaje: [],\n      adModal: 0,\n      adAccion: 0,\n      adNombre: \"\",\n      adId: \"\"\n    };\n  },\n  computed: {\n    formTitle() {\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog(val) {\n      val || this.close();\n    }\n  },\n  created() {\n    this.listar();\n  },\n  methods: {\n    listar() {\n      let me = this;\n      axios\n        .get(\"unidades/\")\n        .then(function(response) {\n          me.medidas = response.data;\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    limpiar() {\n      this.Descripcion = \"\";\n      this.Simbolo = \"\";\n      this.editedIndex = -1;\n    },\n    validar() {\n      this.valida = 0;\n      this.validaMensaje = [];\n      if (this.Descripcion.length < 1) {\n        this.validaMensaje.push(\n          \"La descripcion de la unidad debe tener entre 1-50 caracteres.\"\n        );\n      }\n      if (this.Simbolo.length < 1) {\n        this.validaMensaje.push(\n          \"El simbolo de la unidad no debe tener más de 1 caracteres.\"\n        );\n      }\n      if (this.validaMensaje.length) {\n        this.valida = 1;\n      }\n      return this.valida;\n    },\n    guardar() {\n      let me = this;\n      if (this.validar()) {\n        return;\n      }\n      if (this.editedIndex > -1) {\n        //Código para editar\n        console.log(this.CodigoUnidad, this.Descripcion, this.Simbolo);\n        axios\n          .put(\"unidades/\", {\n            CodigoUnidad: this.CodigoUnidad,\n            Descripcion: this.Descripcion,\n            Simbolo: this.Simbolo\n          })\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n            me.dialogoConfirmacion=true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      } else {\n        axios\n          .post(\"unidades/\", {\n            Descripcion: this.Descripcion,\n            Simbolo: this.Simbolo\n          })\n          .then(function(response) {\n            me.limpiar();\n            me.close();\n            me.listar();\n             me.dialogoConfirmacion=true;\n          })\n          .catch(function(error) {\n            console.log(error);\n          });\n      }\n    },\n    editItem(item) {\n      this.CodigoUnidad = item.CodigoUnidad;\n      this.Descripcion = item.Descripcion;\n      this.Simbolo = item.Simbolo;\n      this.dialog = true;\n      this.editedIndex = 1;\n    },\n    activarDesactivarMostrar(accion, item) {\n      this.adModal = 1;\n      this.adNombre = item.Descripcion;\n      this.adSimbolo = item.Simbolo;\n      this.adId = item.CodigoUnidad;\n      if (accion == 1) {\n        this.adAccion = 1;\n      } else if (accion == 2) {\n        this.adAccion = 2;\n      } else {\n        this.adModal = 0;\n      }\n    },\n    activarDesactivarCerrar() {\n      this.adModal = 0;\n    },\n    activar() {\n      let me = this;\n      axios\n        .put(\"unidades/\", { CodigoUnidad: this.adId })\n        .then(function(response) {\n          me.adModal = 0;\n          me.adAccion = 0;\n          me.adNombre = \"\";\n          me.adSimbolo = \"\";\n          me.adId = \"\";\n          me.listar();\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    desactivar() {\n      let me = this;\n      axios\n        .put(\"unidades/deactivate\", { _id: this.adId })\n        .then(function(response) {\n          me.adModal = 0;\n          me.adAccion = 0;\n          me.adNombre = \"\";\n          me.adId = \"\";\n          me.listar();\n        })\n        .catch(function(error) {\n          console.log(error);\n        });\n    },\n    close() {\n      this.dialog = false;\n    }\n  }\n};\n</script>\n"],"sourceRoot":"src/components/referenciales-productos"}]}