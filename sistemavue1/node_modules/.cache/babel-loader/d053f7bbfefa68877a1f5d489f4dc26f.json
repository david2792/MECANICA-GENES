Id: \"\"\n    };\n  },\n  computed: {\n    formTitle: function formTitle() {\n      // this.limpiar();\n      return this.editedIndex === -1 ? \"Nuevo registro\" : \"Editar registro\";\n    }\n  },\n  watch: {\n    dialog: function dialog(val) {\n      val || this.close();\n    }\n  },\n  created: function created() {\n    this.listar();\n    this.cod();\n    this.selectMarcas();\n    this.selectCategoria();\n    this.selectDeposito();\n    this.selectImpuesto();\n  },\n  methods: {\n    selectMarcas: function selectMarcas() {\n      var me = this;\n      var marcaArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"marcas/\", configuracion).then(function (response) {\n        marcaArray = response.data; //    console.log(marcaArray)\n\n        marcaArray.map(function (x) {\n          me.Marcas.push({\n            text: x.Descripcion,\n            value: x.CodigoMarca\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    selectCategoria: function selectCategoria() {\n      var me = this;\n      var categoriaArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"categorias/\", configuracion).then(function (response) {\n        categoriaArray = response.data; // console.log(categoriaArray)\n\n        categoriaArray.map(function (x) {\n          me.Categorias.push({\n            text: x.Descripcion,\n            value: x.CodigoCategoria\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    selectDeposito: function selectDeposito() {\n      var me = this;\n      var depositoArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"depositos/\", configuracion).then(function (response) {\n        depositoArray = response.data; //console.log(depositoArray)\n\n        depositoArray.map(function (x) {\n          me.Depositos.push({\n            text: x.Nombre,\n            value: x.codigoDeposito\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    selectImpuesto: function selectImpuesto() {\n      var me = this;\n      var impuestoArray = [];\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      axios.get(\"impuestos/\", configuracion).then(function (response) {\n        impuestoArray = response.data; // console.log(categoriaArray)\n\n        impuestoArray.map(function (x) {\n          me.Impuestos.push({\n            text: x.Descripcion,\n            value: x.CodigImpuesto\n          });\n        });\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    listar: function listar() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"productos/listar\", configuracion).then(function (response) {\n        me.productos = response.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    cod: function cod() {\n      var header = {\n        \"auth-token\": this.$store.state.token\n      };\n      var configuracion = {\n        headers: header\n      };\n      var me = this;\n      axios.get(\"productos/codigo\", configuracion).then(function (response) {\n        me.code = response.data; //  this.CodigoProducto=me.code;\n\n        console.log(me.code);\n      }).catch(function (error) {\n        console.log(error);\n      });\n    },\n    limpiar: function limpiar() {\n      this.Descripcion = \"\";\n      